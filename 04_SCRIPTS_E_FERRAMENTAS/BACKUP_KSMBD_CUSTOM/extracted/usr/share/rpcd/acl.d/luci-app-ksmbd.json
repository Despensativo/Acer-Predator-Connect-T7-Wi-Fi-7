{
        "luci-app-ksmbd": {
                "description": "Grant access to LuCI app ksmbd",
                "read": {
                        "file": {
                                "/etc/ksmbd/smb.conf.template": [ "read" ],
                                "/etc/ksmbd/ksmbdpwd.db": [ "read" ],
                                "/usr/sbin/ksmbd.mountd": [ "exec" ],
                                "/usr/sbin/ksmbd-disk-tool": [ "exec" ],
                                "/sbin/modinfo": [ "exec" ],
                                "/bin/df": [ "exec" ],
                                "/bin/sync": [ "exec" ],
                                "/bin/umount": [ "exec" ],
                                "/bin/mount": [ "exec" ],
                                "/sbin/block": [ "exec" ],
                                "/bin/netstat": [ "exec" ]
                        }
                },
                "write": {
                        "file": {
                                "/etc/ksmbd/smb.conf.template": [ "write" ],
                                "/usr/sbin/ksmbd-disk-tool": [ "exec" ]
                        }
                }
        }
}
