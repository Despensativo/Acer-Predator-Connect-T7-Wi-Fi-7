{
  "schema_version": 1,
  "status": "documentation_only_not_ready_for_hardware",
  "artifacts": {
    "launcher": {
      "proposed_name": "t7-ram-launcher-<build-id>.itb",
      "format": "FIT_script",
      "node": "/images/script",
      "dispatch_marker": {
        "offset": "0x5c",
        "ascii": "Flas",
        "hex": "466c6173"
      },
      "max_bytes": 65536,
      "minimum_http_size_unverified": 10240,
      "modes": [
        "load_and_verify",
        "boot_after_verification"
      ],
      "default_mode": "load_and_verify",
      "persistent_writes_allowed": false,
      "addresses": null,
      "expected_kernel_bytes": null,
      "expected_kernel_crc32": null,
      "expected_kernel_sha256": null,
      "session_id": null
    },
    "kernel": {
      "proposed_name": "t7-arm64-diag-<build-id>.itb",
      "format": "FIT_kernel_and_dtb",
      "embedded_initramfs": true,
      "max_fit_bytes": 16777216,
      "max_decompressed_bytes": 33554432,
      "max_arm64_image_size": 33554432,
      "expected_arch": "arm64",
      "config_name": "config@mi01.6",
      "flash_drivers_allowed": false,
      "module_loading_allowed": false,
      "addresses": null,
      "ramoops_region": null
    }
  },
  "candidate_memory_ranges": [
    {
      "role": "kernel",
      "start": "0x41000000",
      "end_exclusive": "0x43000000",
      "approved": false
    },
    {
      "role": "http_launcher",
      "start": "0x44000000",
      "end_exclusive": "0x44010000",
      "approved": false
    },
    {
      "role": "checkpoint",
      "start": "0x45000000",
      "end_exclusive": "0x45001000",
      "approved": false
    },
    {
      "role": "received_fit",
      "start": "0x46000000",
      "end_exclusive": "0x47000000",
      "approved": false
    }
  ],
  "kernel_requirements": {
    "must_be_y": [
      "CONFIG_ARM64",
      "CONFIG_BLK_DEV_INITRD",
      "CONFIG_DEVTMPFS",
      "CONFIG_PROC_FS",
      "CONFIG_SYSFS",
      "CONFIG_TMPFS",
      "CONFIG_PRINTK",
      "CONFIG_SERIAL_EARLYCON",
      "CONFIG_SERIAL_MSM",
      "CONFIG_SERIAL_MSM_CONSOLE",
      "CONFIG_QCOM_SCM",
      "CONFIG_IPQ_GCC_5332",
      "CONFIG_PSTORE",
      "CONFIG_PSTORE_RAM",
      "CONFIG_PSTORE_CONSOLE"
    ],
    "must_be_n": [
      "CONFIG_MTD",
      "CONFIG_MODULES",
      "CONFIG_DEVMEM",
      "CONFIG_PSTORE_BLK",
      "CONFIG_MMC",
      "CONFIG_SCSI",
      "CONFIG_USB_STORAGE",
      "CONFIG_BLK_DEV_NVME",
      "CONFIG_NVMEM_SYSFS"
    ],
    "notes": [
      "Validate all requirements against generated configuration and final binary.",
      "No fixed RAM or ramoops addresses are approved.",
      "Do not copy the current complete OpenWrt root tree into initramfs.",
      "Watchdog handling remains to be verified; nowatchdog is insufficient."
    ]
  },
  "checkpoint": {
    "transport": "tftpput",
    "record_bytes": 64,
    "endian": "little",
    "magic_ascii": "DGT7",
    "version": 1,
    "fields": [
      {
        "offset": 0,
        "bytes": 4,
        "name": "magic"
      },
      {
        "offset": 4,
        "bytes": 4,
