      },
      {
        "offset": 8,
        "bytes": 16,
        "name": "session_id"
      },
      {
        "offset": 24,
        "bytes": 4,
        "name": "stage"
      },
      {
        "offset": 28,
        "bytes": 4,
        "name": "status"
      },
      {
        "offset": 32,
        "bytes": 4,
        "name": "received_bytes"
      },
      {
        "offset": 36,
        "bytes": 4,
        "name": "computed_crc32"
      },
      {
        "offset": 40,
        "bytes": 4,
        "name": "fit_address"
      },
      {
        "offset": 44,
        "bytes": 4,
        "name": "expected_bytes"
      },
      {
        "offset": 48,
        "bytes": 4,
        "name": "expected_crc32"
      },
      {
        "offset": 52,
        "bytes": 12,
        "name": "reserved_zero"
      }
    ],
    "stages": {
      "S00": 0,
      "S10": 10,
      "S20": 20,
      "S30": 30,
      "S40": 40,
      "FAIL": 255
    },
    "server_allow_fallback": false,
    "required_completed_transfer": true,
    "interpretation": "A pre-boot marker does not prove execution of Linux."
  },
  "blockers": [
    "Actual U-Boot banks/heap/stack and buffer usage unverified.",
    "Final DTB placement and firmware reservations not validated.",
    "Ramoops exclusivity and retention after reset not demonstrated.",
    "OEM syntax for CRC comparison and bootm sequencing not fully reviewed.",
    "HTTP minimum-size limit and complete dispatch must be independently validated.",
    "Server does not currently support WRQ and includes unsafe missing-file fallback."
  ],
  "authorization": {
    "compile": false,
    "generate_binary": false,
    "router_access": false,
    "upload": false,
    "install": false
  }
