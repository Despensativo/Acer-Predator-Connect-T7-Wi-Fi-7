/dts-v1/;

#include <arm64/qcom/ipq5332.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Acer Predator Connect T7";
	compatible = "acer,predator-t7", "qcom,ipq5332-ap-mi01.6", "qcom,ipq5332";

	aliases {
		serial0 = &blsp1_uart0;
		ethernet0 = &xgmac2;
		ethernet1 = &xgmac1;
	};

	chosen {
		bootargs = "console=ttyMSM0,115200n8";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 49 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps-button {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&blsp1_uart0 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board {
	clock-frequency = <24000000>;
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		xgmac1: port@1 {
			reg = <1>;
			phy-mode = "2500basex";
			managed = "in-band-status";
			label = "lan";
			pcs-handle = <&pcs0_ch0>;
			local-mac-address = [00 00 00 00 00 00];
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT1_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};

		xgmac2: port@2 {
			reg = <2>;
			phy-mode = "2500basex";
			managed = "in-band-status";
			label = "wan";
			phy-handle = <&phy4>;
			pcs-handle = <&pcs1_ch0>;
			local-mac-address = [00 00 00 00 00 00];
			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT2_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};
	};
};

&pcs0 {
	status = "okay";
};

&pcs1 {
	status = "okay";
};

&mdio {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mdio1_pins>;
	reset-gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;

	phy4: ethernet-phy@4 {
		compatible = "ethernet-phy-id004d.d180";
		reg = <4>;
	};
};

&pcie1 {
	status = "okay";
	num-lanes = <1>;

	perst-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_pins>;

	pcie@0 {
		wifi@0,0 {
			reg = <0x00010000 0 0 0 0>;
			qcom,ath12k-board-id = <4117>;
		};
	};
};

&pcie1_phy {
	reg = <0x004b1000 0x800>;
	num-lanes = <1>;

	qti,multiplexed-phy;
	phy-ahb-shared-reset;

	status = "okay";
};

&tlmm {
	button_pins: button-state {
		pins = "gpio35", "gpio49";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	mdio1_pins: mdio1-state {
		mux_0 {
			pins = "gpio27";
			function = "mdc1";
			drive-strength = <8>;
			bias-disable;
		};

		mux_1 {
			pins = "gpio28";
			function = "mdio1";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pcie1_pins: pci1-pinmux {
		pins = "gpio47";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-high;
	};
};
