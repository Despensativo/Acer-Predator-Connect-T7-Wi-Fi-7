#!/bin/sh /etc/rc.common
# /etc/init.d/predator_dev - Addon Modo DEV: Fail-Safe Anti-Bootloop & Log Persistente (7 Dias)
# Copyright (c) 2026 Predator Connect T7 Custom Tools

START=01
STOP=99

LOG_DIR="/data/boot_logs"
FAIL_COUNT_FILE="/data/boot_fail_count"
FALLBACK_LOG="/data/boot_failsafe_history.log"

get_active_slot() {
	local mtd_num=$(cat /sys/class/ubi/ubi0/mtd_num 2>/dev/null)
	if [ "$mtd_num" = "20" ] || grep -q "rootfs_1" /proc/cmdline 2>/dev/null; then
		echo 2
	else
		echo 1
	fi
}

switch_to_opposite_slot() {
	local cur_slot=$(get_active_slot)
	local target_slot=1
	local target_bootval=1

	if [ "$cur_slot" -eq 1 ]; then
		target_slot=2
		target_bootval=0
	else
		target_slot=1
		target_bootval=1
	fi

	local ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || uptime)
	echo "[$ts] [FAILSAFE-DEV] Chaveamento de emergencia: Slot $cur_slot -> Slot $target_slot" >> "$FALLBACK_LOG"
	echo "[$ts] [FAILSAFE-DEV] Chaveando para Slot $target_slot..." > /dev/console 2>&1

	# Ajusta bootconfig
	echo "$target_bootval" > /proc/boot_info/bootconfig0/rootfs/primaryboot 2>/dev/null
	echo "$target_bootval" > /proc/boot_info/bootconfig1/rootfs/primaryboot 2>/dev/null
	cat /proc/boot_info/bootconfig0/getbinary_bootconfig > /tmp/bc0.bin 2>/dev/null
	cat /proc/boot_info/bootconfig1/getbinary_bootconfig > /tmp/bc1.bin 2>/dev/null

	mtd unlock /dev/mtd3 2>/dev/null
	mtd unlock /dev/mtd4 2>/dev/null
	mtd -e /dev/mtd3 write /tmp/bc0.bin /dev/mtd3 2>/dev/null
	mtd -e /dev/mtd4 write /tmp/bc1.bin /dev/mtd4 2>/dev/null
	rm -f /tmp/bc0.bin /tmp/bc1.bin

	echo 0 > "$FAIL_COUNT_FILE"
	sync
	echo "[$ts] [FAILSAFE-DEV] Particao $target_slot gravada. Reiniciando roteador..." > /dev/console 2>&1
	sleep 1
	reboot -f
	exit 0
}

watchdog_daemon() {
	local safe_uptime="$1"
	local logging_enabled="$2"
	local retention_days="$3"
	local compress_enabled="$4"
	local log_folder="$5"

	# Aguarda atingir o tempo de seguranca
	while true; do
		local cur_up=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
		if [ "$cur_up" -ge "$safe_uptime" ]; then
			break
		fi
		sleep 3
	done

	# Boot saudavel confirmado: zera contador de falhas
	echo 0 > "$FAIL_COUNT_FILE"
	sync
	logger -t "predator-dev" "[FAILSAFE-DEV] Boot confirmado saudavel apos ${safe_uptime}s de uptime. Contador de falhas zerado."

	# Rotina de log persistente
	if [ "$logging_enabled" = "1" ]; then
		# Aguarda mais 10s para garantir que logs de servicos finais (uhttpd, wifi) estejam em logread
		sleep 10
		mkdir -p "$log_folder"

		local cur_slot=$(get_active_slot)
		local timestamp=$(date '+%Y%m%d_%H%M%S' 2>/dev/null)
		[ -z "$timestamp" ] && timestamp="boot_$(date +%s)"
		local raw_log="${log_folder}/boot_${timestamp}_slot${cur_slot}.log"

		{
			echo "================================================================================"
			echo " ACER PREDATOR CONNECT T7 - RELATORIO COMPLETO DE INICIALIZACAO (MODO DEV)"
			echo "================================================================================"
			echo "Data e Hora  : $(date 2>/dev/null)"
			echo "Slot Ativo   : Slot ${cur_slot} ($(cat /proc/cmdline 2>/dev/null))"
			echo "Uptime       : $(uptime 2>/dev/null)"
			echo "Versao Kernel: $(uname -a 2>/dev/null)"
			echo "Hardware     : Qualcomm IPQ5332 Quad-Core + QCN9224 Wi-Fi 7 Tri-Band"
			echo "================================================================================"
			echo ""
			echo "--------------------------------------------------------------------------------"
			echo "1. REGISTRO DO KERNEL (dmesg)"
			echo "--------------------------------------------------------------------------------"
			dmesg 2>/dev/null
			echo ""
			echo "--------------------------------------------------------------------------------"
			echo "2. LOG DE SERVICOS DO SISTEMA (logread / syslog)"
			echo "--------------------------------------------------------------------------------"
			logread 2>/dev/null
			echo ""
			echo "--------------------------------------------------------------------------------"
			echo "3. ULTIMO TRACO DE PANIC / OOPS DE HARDWARE (/dev/mtd23 - 0:SYSTRACE)"
			echo "--------------------------------------------------------------------------------"
			strings /dev/mtd23 2>/dev/null | grep -E "(Fatal|Crash|panic|PC is at|LR is at|Thread name|smem_panic_handler|CRASHED|driver_state)" | tail -n 40
			echo ""
			echo "--------------------------------------------------------------------------------"
			echo "4. ESTADO DAS INTERFACES SEM FIO (Wi-Fi 7 / iw dev)"
			echo "--------------------------------------------------------------------------------"
			iw dev 2>/dev/null || echo "iw nao disponivel"
			echo ""
			echo "--------------------------------------------------------------------------------"
			echo "5. CONSUMO DE MEMORIA E DISCO"
			echo "--------------------------------------------------------------------------------"
			free -m 2>/dev/null
			echo ""
			df -h 2>/dev/null
			echo "================================================================================"
			echo " FIM DO LOG DE BOOT"
			echo "================================================================================"
		} > "$raw_log"

		if [ "$compress_enabled" = "1" ]; then
			gzip -f "$raw_log" 2>/dev/null
			logger -t "predator-dev" "[LOG-DEV] Log de boot salvo em ${raw_log}.gz"
		else
			logger -t "predator-dev" "[LOG-DEV] Log de boot salvo em ${raw_log}"
		fi

		# Limpeza automatica de logs antigos (mais velhos que retention_days)
		if [ -n "$retention_days" ] && [ "$retention_days" -gt 0 ]; then
			find "$log_folder" -type f -name "boot_*.log*" -mtime +"$retention_days" -delete 2>/dev/null
			logger -t "predator-dev" "[LOG-DEV] Logs com mais de ${retention_days} dias purgados."
		fi
	fi
}

start() {
	[ -e /etc/config/predator_dev ] || return 0

	local dev_enabled=$(uci -q get predator_dev.general.enabled || echo 1)
	[ "$dev_enabled" = "1" ] || return 0

	local fs_enabled=$(uci -q get predator_dev.failsafe.enabled || echo 1)
	local max_retries=$(uci -q get predator_dev.failsafe.max_retries || echo 3)
	local safe_uptime=$(uci -q get predator_dev.failsafe.safe_uptime || echo 75)

	local log_enabled=$(uci -q get predator_dev.logging.enabled || echo 1)
	local retention_days=$(uci -q get predator_dev.logging.retention_days || echo 7)
	local compress_enabled=$(uci -q get predator_dev.logging.compress || echo 1)
	local log_folder=$(uci -q get predator_dev.logging.log_dir || echo "$LOG_DIR")

	mkdir -p /data

	# 1. Checagem Fail-Safe Anti-Bootloop
	if [ "$fs_enabled" = "1" ]; then
		local cur_fail=0
		[ -f "$FAIL_COUNT_FILE" ] && cur_fail=$(cat "$FAIL_COUNT_FILE" 2>/dev/null || echo 0)
		cur_fail=$((cur_fail + 1))
		echo "$cur_fail" > "$FAIL_COUNT_FILE"
		sync

		echo "[FAILSAFE-DEV] Contador de inicializacao: $cur_fail / $max_retries (Limite de seguranca)" > /dev/console 2>&1

		if [ "$cur_fail" -ge "$max_retries" ]; then
			echo "[FAILSAFE-DEV] ATENCAO: Limite de falhas alcancado ($cur_fail >= $max_retries)! Alternando particao..." > /dev/console 2>&1
			switch_to_opposite_slot
			return 0
		fi
	fi

	# 2. Inicia daemon guardiao e coletor de logs em plano de fundo
	watchdog_daemon "$safe_uptime" "$log_enabled" "$retention_days" "$compress_enabled" "$log_folder" &
}

stop() {
	return 0
}
