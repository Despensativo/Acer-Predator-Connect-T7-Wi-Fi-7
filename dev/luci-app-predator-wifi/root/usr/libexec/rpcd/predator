do_wake_on_lan() {
	read input
	MAC=$(echo "$input" | jsonfilter -e '@.mac' | tr 'a-f' 'A-F')
	if ! echo "$MAC" | grep -Eq '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; then
		echo '{"success":false,"error":"invalid_mac"}'
		exit 0
	fi
	/usr/bin/etherwake -i br-lan "$MAC" 2>/dev/null || /usr/bin/etherwake -D -i br-lan "$MAC" 2>/dev/null || true
	echo "{\"success\":true,\"mac\":\"$MAC\"}"
}

do_optimize_channels() {
	local nf0=$(cfg80211tool ath0 get_channf 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9-')
	local nf1=$(cfg80211tool ath1 get_channf 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9-')
	local nf2=$(cfg80211tool ath2 get_channf 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9-')
	[ -z "$nf0" ] || [ "$nf0" -ge 0 ] 2>/dev/null && nf0="-95"
	[ -z "$nf1" ] || [ "$nf1" -ge 0 ] 2>/dev/null && nf1="-102"
	[ -z "$nf2" ] || [ "$nf2" -ge 0 ] 2>/dev/null && nf2="-99"

	local cu0=$(cfg80211tool wifi0 g_chanutil 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local cu1=$(cfg80211tool wifi1 g_chanutil 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local cu2=$(cfg80211tool wifi2 g_chanutil 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local free0=$(cfg80211tool wifi0 g_ch_util_free 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local free1=$(cfg80211tool wifi1 g_ch_util_free 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local free2=$(cfg80211tool wifi2 g_ch_util_free 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')

	if [ -z "$free0" ] || [ "$free0" -gt 100 ] 2>/dev/null || { [ "$free0" = "0" ] && [ "${cu0:-0}" -lt 50 ] 2>/dev/null; }; then
		[ "${cu0:-0}" -le 100 ] 2>/dev/null && free0=$((100 - ${cu0:-15})) || free0="85"
	fi
	if [ -z "$free1" ] || [ "$free1" -gt 100 ] 2>/dev/null || { [ "$free1" = "0" ] && [ "${cu1:-0}" -lt 50 ] 2>/dev/null; }; then
		[ "${cu1:-0}" -le 100 ] 2>/dev/null && free1=$((100 - ${cu1:-3})) || free1="97"
	fi
	if [ -z "$free2" ] || [ "$free2" -gt 100 ] 2>/dev/null || { [ "$free2" = "0" ] && [ "${cu2:-0}" -lt 50 ] 2>/dev/null; }; then
		[ "${cu2:-0}" -le 100 ] 2>/dev/null && free2=$((100 - ${cu2:-0})) || free2="100"
	fi

	local cur0=$(uci -q get wireless.wifi0.channel || echo "6")
	local cur1=$(uci -q get wireless.wifi1.channel || echo "100")
	local cur2=$(uci -q get wireless.wifi2.channel || echo "37")
	local ht1=$(uci -q get wireless.wifi1.htmode || echo "HT160")
	if [ "$(uci -q get wireless.wifi1.puncture_bitmap)" = "61440" ]; then
		ht1="HT240"
	fi

	# Optimal non-overlapping selection based on CCA free medium % and band width constraints
	local best0="$cur0"
	if [ "$cur0" = "auto" ] || [ "$free0" -lt 45 ] 2>/dev/null; then
		case "$cur0" in
			1) best0="6" ;;
			6) best0="11" ;;
			11) best0="6" ;;
			*) best0="6" ;;
		esac
	fi

	local best1="$cur1"
	if [ "$ht1" = "HT240" ]; then
		best1="100"
	elif [ "$ht1" = "HT160" ]; then
		if [ "$cur1" = "auto" ] || [ "$free1" -lt 60 ] 2>/dev/null; then
			[ "$cur1" = "36" ] && best1="100" || best1="36"
		else
			[ "$cur1" != "36" ] && [ "$cur1" != "100" ] && best1="36"
		fi
	else
		[ "$cur1" = "auto" ] && best1="36"
	fi

	local best2="$cur2"
	if [ "$cur2" = "auto" ] || [ "$free2" -lt 70 ] 2>/dev/null; then
		case "$cur2" in
			37) best2="69" ;;
			69) best2="37" ;;
			*) best2="37" ;;
		esac
	fi

	if [ "$best0" != "$cur0" ] || [ "$best1" != "$cur1" ] || [ "$best2" != "$cur2" ]; then
		uci set wireless.wifi0.channel="$best0"
		uci set wireless.wifi1.channel="$best1"
		uci set wireless.wifi2.channel="$best2"
		uci commit wireless
		(
			sleep 1
			/sbin/wifi reload 2>/dev/null
			sleep 2
			[ -x /lib/wifi_hardware_tune.sh ] && /lib/wifi_hardware_tune.sh
			/etc/init.d/predator_rf start 2>/dev/null
		) &
	else
		/etc/init.d/predator_rf start >/dev/null 2>&1 &
	fi
	echo "{\"success\":true,\"ch0\":\"$best0\",\"ch1\":\"$best1\",\"ch2\":\"$best2\",\"nf0\":\"$nf0\",\"nf1\":\"$nf1\",\"nf2\":\"$nf2\",\"free0\":\"$free0\",\"free1\":\"$free1\",\"free2\":\"$free2\"}"
}

do_setup_wireguard() {
	read input
	ACT=$(echo "$input" | jsonfilter -e '@.action')
	[ -z "$ACT" ] && ACT="toggle"
	if [ "$ACT" = "import" ] || [ "$ACT" = "save" ]; then
		if [ "$ACT" = "import" ]; then
			CONF=$(echo "$input" | jsonfilter -e '@.config')
			PRIV=$(echo "$CONF" | grep -iE '^[[:space:]]*PrivateKey[[:space:]]*=' | head -n1 | cut -d'=' -f2- | tr -d ' \r\t')
			ADDR=$(echo "$CONF" | grep -iE '^[[:space:]]*Address[[:space:]]*=' | head -n1 | cut -d'=' -f2- | tr -d ' \r\t')
			MTU=$(echo "$CONF" | grep -iE '^[[:space:]]*MTU[[:space:]]*=' | head -n1 | cut -d'=' -f2- | tr -d ' \r\t')
			PUB=$(echo "$CONF" | grep -iE '^[[:space:]]*PublicKey[[:space:]]*=' | head -n1 | cut -d'=' -f2- | tr -d ' \r\t')
			PSK=$(echo "$CONF" | grep -iE '^[[:space:]]*PresharedKey[[:space:]]*=' | head -n1 | cut -d'=' -f2- | tr -d ' \r\t')
			ENDP=$(echo "$CONF" | grep -iE '^[[:space:]]*Endpoint[[:space:]]*=' | head -n1 | cut -d'=' -f2- | tr -d ' \r\t')
			ALLOW=$(echo "$CONF" | grep -iE '^[[:space:]]*AllowedIPs[[:space:]]*=' | head -n1 | cut -d'=' -f2- | tr -d ' \r\t')
			KEEP=$(echo "$CONF" | grep -iE '^[[:space:]]*PersistentKeepalive[[:space:]]*=' | head -n1 | cut -d'=' -f2- | tr -d ' \r\t')
			EP_HOST=$(echo "$ENDP" | sed 's/:[0-9]*$//' | tr -d '[]')
			EP_PORT=$(echo "$ENDP" | awk -F':' '{print $NF}')
		else
			PRIV=$(echo "$input" | jsonfilter -e '@.priv' | tr -d ' \r\t')
			PUB=$(echo "$input" | jsonfilter -e '@.pub' | tr -d ' \r\t')
			PSK=$(echo "$input" | jsonfilter -e '@.psk' | tr -d ' \r\t')
			ADDR=$(echo "$input" | jsonfilter -e '@.address' | tr -d ' \r\t')
			MTU=$(echo "$input" | jsonfilter -e '@.mtu' | tr -d ' \r\t')
			EP_HOST=$(echo "$input" | jsonfilter -e '@.endpoint_host' | tr -d ' \r\t[]')
			EP_PORT=$(echo "$input" | jsonfilter -e '@.endpoint_port' | tr -d ' \r\t')
			ALLOW=$(echo "$input" | jsonfilter -e '@.allowed_ips' | tr -d ' \r\t')
			KEEP=$(echo "$input" | jsonfilter -e '@.keepalive' | tr -d ' \r\t')
		fi

		if [ -z "$PRIV" ] || [ -z "$PUB" ]; then
			echo '{"success":false,"error":"invalid_wg_conf"}'
			exit 0
		fi
		[ -z "$ADDR" ] && ADDR="10.2.0.2/32"
		[ -z "$ALLOW" ] && ALLOW="0.0.0.0/0"
		[ -z "$KEEP" ] && KEEP="25"
		[ -z "$MTU" ] && MTU="1420"
		[ -z "$EP_PORT" ] && EP_PORT="51820"

		uci -q delete network.wg0
		uci set network.wg0='interface'
		uci set network.wg0.proto='wireguard'
		uci set network.wg0.private_key="$PRIV"
		uci set network.wg0.auto='1'
		uci set network.wg0.mtu="$MTU"
		for a in $(echo "$ADDR" | tr ',' ' '); do
			uci add_list network.wg0.addresses="$a"
		done

		uci -q delete network.wgpeer0
		uci set network.wgpeer0='wireguard_wg0'
		uci set network.wgpeer0.public_key="$PUB"
		[ -n "$PSK" ] && uci set network.wgpeer0.preshared_key="$PSK"
		[ -n "$EP_HOST" ] && uci set network.wgpeer0.endpoint_host="$EP_HOST"
		[ -n "$EP_PORT" ] && uci set network.wgpeer0.endpoint_port="$EP_PORT"
		uci set network.wgpeer0.route_allowed_ips='1'
		uci set network.wgpeer0.persistent_keepalive="$KEEP"
		for al in $(echo "$ALLOW" | tr ',' ' '); do
			uci add_list network.wgpeer0.allowed_ips="$al"
		done
		uci commit network

		# Ensure wg0 is in wan firewall zone for NAT masquerading
		local fz_idx=0
		while uci -q get firewall.@zone[$fz_idx] >/dev/null 2>&1; do
			if [ "$(uci -q get firewall.@zone[$fz_idx].name)" = "wan" ]; then
				local cur_nets=$(uci -q get firewall.@zone[$fz_idx].network)
				if ! echo "$cur_nets" | grep -qw "wg0"; then
					uci set firewall.@zone[$fz_idx].network="$cur_nets wg0"
					uci commit firewall
				fi
				break
			fi
			fz_idx=$((fz_idx + 1))
		done

		insmod wireguard 2>/dev/null || true
		( ifdown wg0 2>/dev/null; sleep 1; ifup wg0 2>/dev/null; /etc/init.d/firewall reload 2>/dev/null ) &
		echo "{\"success\":true,\"action\":\"$ACT\"}"
	elif [ "$ACT" = "delete" ]; then
		( ifdown wg0 2>/dev/null; ip link del wg0 2>/dev/null ) &
		uci -q delete network.wg0
		uci -q delete network.wgpeer0
		uci commit network
		echo '{"success":true,"action":"delete"}'
	else
		EN=$(echo "$input" | jsonfilter -e '@.enabled')
		if [ "$EN" = "1" ]; then
			uci set network.wg0.auto='1'
			uci commit network
			insmod wireguard 2>/dev/null || true
			( ifup wg0 2>/dev/null ) &
		else
			uci set network.wg0.auto='0'
			uci commit network
			( ifdown wg0 2>/dev/null; ip link del wg0 2>/dev/null ) &
		fi
		echo "{\"success\":true,\"enabled\":\"$EN\"}"
	fi
}

do_set_schedule() {
	read input
	ACT=$(echo "$input" | jsonfilter -e '@.action')
	if [ "$ACT" = "test_down" ]; then
		( /sbin/wifi_schedule.sh down >/dev/null 2>&1 ) &
		echo '{"success":true,"action":"test_down"}'
		exit 0
	elif [ "$ACT" = "test_up" ]; then
		( /sbin/wifi_schedule.sh up >/dev/null 2>&1 ) &
		echo '{"success":true,"action":"test_up"}'
		exit 0
	fi

	EN=$(echo "$input" | jsonfilter -e '@.enabled')
	START=$(echo "$input" | jsonfilter -e '@.start')
	STOP=$(echo "$input" | jsonfilter -e '@.stop')
	DAYS=$(echo "$input" | jsonfilter -e '@.days')
	[ -z "$EN" ] && EN="0"
	[ -z "$START" ] && START="00:00"
	[ -z "$STOP" ] && STOP="06:00"
	[ -z "$DAYS" ] && DAYS="*"

	uci set tripleband.tripleband.sched_enable="$EN"
	uci set tripleband.tripleband.sched_start="$START"
	uci set tripleband.tripleband.sched_stop="$STOP"
	uci set tripleband.tripleband.sched_days="$DAYS"
	uci commit tripleband

	mkdir -p /etc/crontabs
	touch /etc/crontabs/root
	sed -i '/#PREDATOR_WIFI_SCHED/d' /etc/crontabs/root 2>/dev/null || true
	if [ "$EN" = "1" ]; then
		local h_down=$(echo "$START" | cut -d':' -f1 | sed 's/^0//')
		local m_down=$(echo "$START" | cut -d':' -f2 | sed 's/^0//')
		local h_up=$(echo "$STOP" | cut -d':' -f1 | sed 's/^0//')
		local m_up=$(echo "$STOP" | cut -d':' -f2 | sed 's/^0//')
		[ -z "$h_down" ] && h_down="0"
		[ -z "$m_down" ] && m_down="0"
		[ -z "$h_up" ] && h_up="6"
		[ -z "$m_up" ] && m_up="0"
		echo "$m_down $h_down * * $DAYS /sbin/wifi_schedule.sh down #PREDATOR_WIFI_SCHED" >> /etc/crontabs/root
		echo "$m_up $h_up * * $DAYS /sbin/wifi_schedule.sh up #PREDATOR_WIFI_SCHED" >> /etc/crontabs/root
	fi
	/etc/init.d/cron reload 2>/dev/null || /etc/init.d/cron restart 2>/dev/null || true
	echo "{\"success\":true,\"enabled\":\"$EN\",\"start\":\"$START\",\"stop\":\"$STOP\",\"days\":\"$DAYS\"}"
}

do_set_service() {
	read input
	SVC=$(echo "$input" | jsonfilter -e '@.service')
	EN=$(echo "$input" | jsonfilter -e '@.enabled')
	[ -z "$EN" ] && EN="0"
	case "$SVC" in
		igmpproxy)
			uci set tripleband.tripleband.igmpproxy_enable="$EN" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			if [ "$EN" = "1" ]; then
				echo 1 > /proc/net/igmp_snooping 2>/dev/null || true
				uci set mcproxy.mcproxy.disabled='0' 2>/dev/null || true
				uci set mcproxy.@instance[0].disabled='0' 2>/dev/null || true
				uci commit mcproxy 2>/dev/null || true
				/etc/init.d/mcproxy enable 2>/dev/null || true
				/etc/init.d/mcproxy restart 2>/dev/null || true
				for a in ath0 ath1 ath2; do
					[ -d "/sys/class/net/$a" ] && cfg80211tool "$a" mcastenhance 2 2>/dev/null || true
				done
			else
				uci set mcproxy.mcproxy.disabled='1' 2>/dev/null || true
				uci commit mcproxy 2>/dev/null || true
				/etc/init.d/mcproxy stop 2>/dev/null || true
				/etc/init.d/mcproxy disable 2>/dev/null || true
				killall mcproxy igmpproxy 2>/dev/null || true
			fi
			;;
		doh)
			if [ "$EN" = "1" ]; then
				/etc/init.d/https-dns-proxy enable 2>/dev/null || true
				/etc/init.d/https-dns-proxy restart 2>/dev/null || true
			else
				/etc/init.d/https-dns-proxy stop 2>/dev/null || true
				killall https-dns-proxy 2>/dev/null || true
			fi
			;;
		quic_block)
			uci set tripleband.tripleband.quic_block="$EN" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			while iptables -D FORWARD -p udp --dport 443 -j REJECT 2>/dev/null; do :; done
			while iptables -D FORWARD -p udp --dport 443 -j DROP 2>/dev/null; do :; done
			if [ "$EN" = "1" ]; then
				iptables -I FORWARD 1 -p udp --dport 443 -j REJECT 2>/dev/null || true
			fi
			;;
		opkg_shield)
			cat << 'EOF' > /etc/opkg/distfeeds.conf
src/gz openwrt_base http://archive.openwrt.org/releases/19.07.10/packages/arm_cortex-a7_neon-vfpv4/base
src/gz openwrt_luci http://archive.openwrt.org/releases/19.07.10/packages/arm_cortex-a7_neon-vfpv4/luci
src/gz openwrt_packages http://archive.openwrt.org/releases/19.07.10/packages/arm_cortex-a7_neon-vfpv4/packages
src/gz openwrt_routing http://archive.openwrt.org/releases/19.07.10/packages/arm_cortex-a7_neon-vfpv4/routing
src/gz openwrt_telephony http://archive.openwrt.org/releases/19.07.10/packages/arm_cortex-a7_neon-vfpv4/telephony
EOF
			sed -i '/check_signature/d' /etc/opkg.conf 2>/dev/null || true
			if [ "$EN" = "1" ] && [ -f /usr/lib/opkg/status ]; then
				awk '
				/^Package:/ {
					pkg = $2
					hold = 0
					if (pkg ~ /^(kernel|kmod-|hostapd|wpa-|iw|qca-|sqm-|luci-app-sqm|luci-base|rpcd|ubus|uci|netifd|firewall|dnsmasq|ksmbd|wireguard|https-dns-proxy|base-files|libc|libgcc|busybox|procd|fstools|mtd)/) {
						hold = 1
					}
				}
				/^Status:/ {
					if (hold == 1) {
						print "Status: install hold installed"
						next
					}
				}
				{ print }
				' /usr/lib/opkg/status > /tmp/opkg_status.new && mv /tmp/opkg_status.new /usr/lib/opkg/status
			fi
			( opkg update >/tmp/opkg_update.log 2>&1 ) &
			;;
		openvpn)
			if [ "$EN" = "1" ]; then
				/etc/init.d/openvpn start 2>/dev/null || true
			else
				/etc/init.d/openvpn stop 2>/dev/null || killall openvpn 2>/dev/null || true
			fi
			;;
	esac
	echo "{\"success\":true,\"service\":\"$SVC\",\"enabled\":\"$EN\"}"
}

do_get_luci_wireless() {
	local iw_out=$(iw dev 2>/dev/null)
	local state_out=$(cat /var/state/wireless 2>/dev/null)
	local first_radio=1
	printf '{'

	for rdev in wifi0 wifi1 wifi2; do
		[ -z "$(uci -q get wireless.$rdev)" ] && continue
		local p_ath="ath0"
		local hw_name="Qualcomm IPQ5332 Wi-Fi 7 (2.4 GHz)"
		local hw_modes='["b","g","n","ax","be"]'
		local ht_modes='["HT20","HT40"]'
		local def_ch=6
		local def_freq=2437
		local def_w=40
		local def_txp=22
		local def_nf=-95

		if [ "$rdev" = "wifi1" ]; then
			p_ath="ath1"
			hw_name="Qualcomm QCN9224 Wi-Fi 7 (5 GHz)"
			hw_modes='["a","n","ac","ax","be"]'
			ht_modes='["HT20","HT40","HT80","HT160","HT240"]'
			def_ch=36
			def_freq=5180
			def_w=80
			def_txp=23
			def_nf=-102
		elif [ "$rdev" = "wifi2" ]; then
			p_ath="ath2"
			hw_name="Qualcomm QCN9224 Wi-Fi 7 (6 GHz)"
			hw_modes='["a","ax","be"]'
			ht_modes='["HT20","HT40","HT80","HT160","HT240","HT320"]'
			def_ch=37
			def_freq=6135
			def_w=320
			def_txp=20
			def_nf=-99
		fi

		local r_dis=$(uci -q get wireless.$rdev.disabled || echo "0")
		local r_ch=$(uci -q get wireless.$rdev.channel || echo "auto")
		local r_hwm=$(uci -q get wireless.$rdev.hwmode || echo "11bea")
		local r_htm=$(uci -q get wireless.$rdev.htmode || echo "HT80")
		local r_txp=$(uci -q get wireless.$rdev.txpower || echo "$def_txp")
		local r_ctry=$(uci -q get wireless.$rdev.country || echo "BR")
		local r_punc=$(uci -q get wireless.$rdev.puncture_bitmap || echo "0")
		local r_coex=$(uci -q get wireless.$rdev.chan_coex_disable || uci -q get wireless.${rdev}_ap.disablecoext || echo "0")

		local ath_block=$(echo "$iw_out" | awk -v dev="$p_ath" '
			$1 == "Interface" && $2 == dev { inf=1; next }
			$1 == "Interface" && $2 != dev { inf=0 }
			$1 ~ /^phy#/ { inf=0 }
			inf { print }
		')
		local cur_ch=$(echo "$ath_block" | awk '/channel /{print $2}')
		local cur_freq=$(echo "$ath_block" | awk '/channel /{gsub(/[()]/,"",$3); print int($3)}')
		local cur_w=$(echo "$ath_block" | awk -F'width: ' '/width: /{print int($2)}')
		local cur_txp=$(echo "$ath_block" | awk '/txpower /{print int($2)}')
		local cur_bssid=$(echo "$ath_block" | awk '/addr /{print toupper($2)}')

		[ -z "$cur_ch" ] && { [ "$r_ch" != "auto" ] && cur_ch="$r_ch" || cur_ch="$def_ch"; }
		if [ -z "$cur_freq" ] || [ "$cur_freq" = "0" ]; then
			if [ "$rdev" = "wifi0" ]; then
				[ "$cur_ch" = "14" ] && cur_freq=2484 || cur_freq=$((2407 + cur_ch * 5))
			elif [ "$rdev" = "wifi1" ]; then
				cur_freq=$((5000 + cur_ch * 5))
			else
				cur_freq=$((5950 + cur_ch * 5))
			fi
		fi
		[ -z "$cur_w" ] || [ "$cur_w" = "0" ] && cur_w="$def_w"
		if [ "$r_htm" = "HT240" ] || [ "$r_punc" = "61440" ]; then
			[ "$cur_w" = "320" ] && cur_w=240
		fi
		[ -z "$cur_txp" ] || [ "$cur_txp" -le 0 ] 2>/dev/null || [ "$cur_txp" -gt 30 ] 2>/dev/null && {
			[ "$r_txp" != "auto" ] && [ -n "$r_txp" ] && cur_txp="$r_txp" || cur_txp="$def_txp"
		}

		local nf=$(cfg80211tool "$p_ath" get_channf 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9-')
		[ -z "$nf" ] || [ "$nf" -ge 0 ] 2>/dev/null && nf="$def_nf"

		local br_kbps=1441200
		if [ "$rdev" = "wifi0" ]; then
			[ "$cur_w" = "40" ] && br_kbps=688200 || br_kbps=344100
		else
			case "$cur_w" in
				320) br_kbps=5764800 ;;
				240) br_kbps=4323600 ;;
				160) br_kbps=2882400 ;;
				80)  br_kbps=1441200 ;;
				40)  br_kbps=720600 ;;
				*)   br_kbps=360300 ;;
			esac
		fi

		local r_up="false"
		local r_dis_bool="false"
		[ "$r_dis" = "1" ] && r_dis_bool="true"
		if [ "$r_dis" != "1" ] && [ -d "/sys/class/net/$p_ath" ] && [ -n "$cur_bssid" ] && [ "$cur_bssid" != "00:00:00:00:00:00" ]; then
			r_up="true"
		fi

		[ $first_radio -eq 0 ] && printf ','
		first_radio=0

		printf '"%s":{"up":%s,"disabled":%s,"config":{"channel":"%s","hwmode":"%s","htmode":"%s","txpower":%s,"country":"%s","chan_coex_disable":"%s","puncture_bitmap":"%s"},"iwinfo":{"hardware":{"name":"%s"},"hwmodes":%s,"htmodes":%s,"channel":%s,"frequency":%s,"width":%s,"txpower":%s,"noise":%s,"bitrate":%s,"country":"%s"},"interfaces":[' \
			"$rdev" "$r_up" "$r_dis_bool" "$r_ch" "$r_hwm" "$r_htm" "${cur_txp:-20}" "$r_ctry" "$r_coex" "$r_punc" \
			"$hw_name" "$hw_modes" "$ht_modes" "${cur_ch:-1}" "${cur_freq:-2437}" "${cur_w:-40}" "${cur_txp:-20}" "${nf:--95}" "$br_kbps" "$r_ctry"

		local first_vif=1
		for sec in $(uci show wireless 2>/dev/null | grep '=wifi-iface' | cut -d'.' -f2 | cut -d'=' -f1); do
			local v_dev=$(uci -q get wireless.$sec.device)
			[ "$v_dev" != "$rdev" ] && continue

			local v_mode=$(uci -q get wireless.$sec.mode || echo "ap")
			local v_ssid=$(uci -q get wireless.$sec.ssid || echo "")
			local v_enc=$(uci -q get wireless.$sec.encryption || echo "none")
			local v_net=$(uci -q get wireless.$sec.network || echo "lan")
			local v_dis=$(uci -q get wireless.$sec.disabled || echo "0")
			local v_dis_bool="false"
			[ "$v_dis" = "1" ] || [ "$r_dis" = "1" ] && v_dis_bool="true"

			local v_ifname=$(echo "$state_out" | awk -F"'" -v s="wireless.${sec}.ifname=" '$1 == s {print $2; exit}')
			[ -z "$v_ifname" ] && v_ifname=$(uci -q get wireless.$sec.ifname)
			if [ -z "$v_ifname" ]; then
				case "$sec" in
					wifi0_ap) v_ifname="ath0" ;;
					wifi1_ap) v_ifname="ath1" ;;
					wifi2_ap) v_ifname="ath2" ;;
					wwan_sta)
						[ "$rdev" = "wifi0" ] && v_ifname="ath01"
						[ "$rdev" = "wifi1" ] && v_ifname="ath11"
						[ "$rdev" = "wifi2" ] && v_ifname="ath21"
						;;
					*) v_ifname="$p_ath" ;;
				esac
			fi

			local v_bssid="$cur_bssid"
			if [ -f "/sys/class/net/$v_ifname/address" ]; then
				v_bssid=$(cat "/sys/class/net/$v_ifname/address" 2>/dev/null | tr 'a-z' 'A-Z')
			fi
			[ "$v_dis_bool" = "true" ] && v_bssid="00:00:00:00:00:00"

			local iwinfo_mode="Master"
			[ "$v_mode" = "sta" ] && iwinfo_mode="Client"
			[ "$v_mode" = "mesh" ] && iwinfo_mode="Mesh"
			[ "$v_mode" = "monitor" ] && iwinfo_mode="Monitor"

			local v_sig=0
			local v_qual=80
			if [ "$v_dis_bool" = "true" ] || [ "$r_up" = "false" ]; then
				v_sig=0
				v_qual=0
			elif [ "$v_mode" = "sta" ]; then
				local link_out=$(iw dev "$v_ifname" link 2>/dev/null)
				if echo "$link_out" | grep -q "^Connected to"; then
					v_bssid=$(echo "$link_out" | awk '/^Connected to/{print toupper($3)}')
					v_sig=$(echo "$link_out" | awk '/signal:/{print int($2)}')
					[ -z "$v_sig" ] && v_sig=-60
					v_qual=$(( 2 * (v_sig + 100) ))
					[ "$v_qual" -lt 5 ] && v_qual=5
					[ "$v_qual" -gt 100 ] && v_qual=100
				else
					v_bssid="00:00:00:00:00:00"
					v_sig=0
					v_qual=0
				fi
			else
				local best_sig=$(hostapd_cli -p "/var/run/hostapd-$rdev" -i "$v_ifname" all_sta 2>/dev/null | awk -F'=' '/^signal=/{s=int($2); if(s<0 && (best==0 || s>best)) best=s} END{print best+0}')
				if [ -n "$best_sig" ] && [ "$best_sig" -lt 0 ] 2>/dev/null; then
					v_sig="$best_sig"
					v_qual=$(( 2 * (v_sig + 100) ))
					[ "$v_qual" -lt 10 ] && v_qual=10
					[ "$v_qual" -gt 100 ] && v_qual=100
				fi
			fi

			local enc_json='{"enabled":false}'
			case "$v_enc" in
				sae*)
					if [ "$v_enc" = "sae-mixed" ]; then
						enc_json='{"enabled":true,"wpa":[2,3],"authentication":["psk","sae"],"ciphers":["ccmp"]}'
					else
						enc_json='{"enabled":true,"wpa":[3],"authentication":["sae"],"ciphers":["ccmp"]}'
					fi
					;;
				psk2*)
					case "$v_enc" in
						*tkip*) enc_json='{"enabled":true,"wpa":[2],"authentication":["psk"],"ciphers":["tkip","ccmp"]}' ;;
						*)      enc_json='{"enabled":true,"wpa":[2],"authentication":["psk"],"ciphers":["ccmp"]}' ;;
					esac
					;;
				psk-mixed*|psk+psk2*)
					enc_json='{"enabled":true,"wpa":[1,2],"authentication":["psk"],"ciphers":["tkip","ccmp"]}'
					;;
				psk*)
					enc_json='{"enabled":true,"wpa":[1],"authentication":["psk"],"ciphers":["tkip"]}'
					;;
				owe*)
					enc_json='{"enabled":true,"wpa":[3],"authentication":["owe"],"ciphers":["ccmp"]}'
					;;
				wpa3-mixed*)
					enc_json='{"enabled":true,"wpa":[2,3],"authentication":["802.1x"],"ciphers":["ccmp"]}'
					;;
				wpa3*)
					enc_json='{"enabled":true,"wpa":[3],"authentication":["802.1x"],"ciphers":["ccmp"]}'
					;;
				wpa2*)
					enc_json='{"enabled":true,"wpa":[2],"authentication":["802.1x"],"ciphers":["ccmp"]}'
					;;
				wpa*)
					enc_json='{"enabled":true,"wpa":[1],"authentication":["802.1x"],"ciphers":["tkip"]}'
					;;
			esac

			local clean_ssid=$(echo "$v_ssid" | sed 's/\\/\\\\/g; s/"/\\"/g')
			local net_json=$(echo "$v_net" | awk '{printf "["; for(i=1;i<=NF;i++){if(i>1)printf ","; printf "\"%s\"",$i}; printf "]"}')

			[ $first_vif -eq 0 ] && printf ','
			first_vif=0

			printf '{"section":"%s","ifname":"%s","config":{"mode":"%s","ssid":"%s","encryption":"%s","network":%s,"disabled":%s},"iwinfo":{"ifname":"%s","ssid":"%s","bssid":"%s","mode":"%s","channel":%s,"frequency":%s,"width":%s,"txpower":%s,"signal":%s,"noise":%s,"quality":%s,"quality_max":100,"bitrate":%s,"country":"%s","encryption":%s}}' \
				"$sec" "$v_ifname" "$v_mode" "$clean_ssid" "$v_enc" "$net_json" "$v_dis_bool" \
				"$v_ifname" "$clean_ssid" "$v_bssid" "$iwinfo_mode" "${cur_ch:-1}" "${cur_freq:-2437}" "${cur_w:-40}" "${cur_txp:-20}" \
				"$v_sig" "${nf:--95}" "$v_qual" "$br_kbps" "$r_ctry" "$enc_json"
		done

		printf ']}'
	done

	printf '}\n'
}

do_luci_wifi_assoclist() {
	read input
	local dev=$(echo "$input" | jsonfilter -e '@.device' 2>/dev/null)
	case "$dev" in
		wifi0|wifi0.network1) dev="ath0" ;;
		wifi1|wifi1.network1) dev="ath1" ;;
		wifi2|wifi2.network1) dev="ath2" ;;
	esac
	[ -z "$dev" ] && dev="ath0"

	local rdev="wifi0"
	local def_w=40
	local def_nf=-95
	case "$dev" in
		ath1*) rdev="wifi1"; def_w=80; def_nf=-102 ;;
		ath2*) rdev="wifi2"; def_w=320; def_nf=-99 ;;
	esac

	local nf=$(cfg80211tool "$dev" get_channf 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9-')
	[ -z "$nf" ] || [ "$nf" -ge 0 ] 2>/dev/null && nf="$def_nf"
	local cur_w=$(iw dev "$dev" info 2>/dev/null | awk -F'width: ' '/width: /{print int($2)}')
	[ -z "$cur_w" ] || [ "$cur_w" = "0" ] && cur_w="$def_w"
	local punc=$(uci -q get wireless.$rdev.puncture_bitmap || echo "0")
	[ "$punc" = "61440" ] && [ "$cur_w" = "320" ] && cur_w=240

	local hapd_sta=$(hostapd_cli -p "/var/run/hostapd-$rdev" -i "$dev" all_sta 2>/dev/null)
	local wcfg_sta=$(wlanconfig "$dev" list sta 2>/dev/null)

	printf '{"results":['
	echo "$wcfg_sta" | awk -v nf="$nf" -v vw="$cur_w" '
	BEGIN { first = 1 }
	/^[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:/ {
		mac = toupper($1)
		txr_m = int($4)
		rxr_m = int($5)
		if (txr_m <= 0) txr_m = 688
		if (rxr_m <= 0) rxr_m = txr_m
		tx_kbps = txr_m * 1000
		rx_kbps = rxr_m * 1000
		rssi = int($6)
		if (rssi > 0) sig = -95 + rssi
		else if (rssi < 0) sig = rssi
		else sig = -55
		if (sig > -20) sig = -45

		eht = "false"; he = "false"; vht = "false"; ht = "false"
		mhz = vw
		if ($0 ~ /EHT320/) { eht = "true"; mhz = vw }
		else if ($0 ~ /EHT160/) { eht = "true"; mhz = 160 }
		else if ($0 ~ /EHT80/) { eht = "true"; mhz = 80 }
		else if ($0 ~ /EHT40/) { eht = "true"; mhz = 40 }
		else if ($0 ~ /EHT20/) { eht = "true"; mhz = 20 }
		else if ($0 ~ /HE160/) { he = "true"; mhz = 160 }
		else if ($0 ~ /HE80/) { he = "true"; mhz = 80 }
		else if ($0 ~ /HE40/) { he = "true"; mhz = 40 }
		else if ($0 ~ /HE20/) { he = "true"; mhz = 20 }
		else if ($0 ~ /VHT160/) { vht = "true"; mhz = 160 }
		else if ($0 ~ /VHT80/) { vht = "true"; mhz = 80 }
		else if ($0 ~ /VHT40/) { vht = "true"; mhz = 40 }
		else if ($0 ~ /VHT20/) { vht = "true"; mhz = 20 }
		else { ht = "true" }

		mcs = 11
		if (vht == "true") mcs = 9
		else if (ht == "true") mcs = 7

		if (!first) printf ","
		first = 0
		printf "{\"mac\":\"%s\",\"signal\":%d,\"noise\":%d,\"inactive\":0,\"rx\":{\"rate\":%d,\"mhz\":%d,\"mcs\":%d,\"nss\":2,\"ht\":%s,\"vht\":%s,\"he\":%s,\"eht\":%s,\"short_gi\":true},\"tx\":{\"rate\":%d,\"mhz\":%d,\"mcs\":%d,\"nss\":2,\"ht\":%s,\"vht\":%s,\"he\":%s,\"eht\":%s,\"short_gi\":true}}", \
			mac, sig, nf, rx_kbps, mhz, mcs, ht, vht, he, eht, tx_kbps, mhz, mcs, ht, vht, he, eht
	}
	'
	printf ']}\n'
}

do_luci_wifi_scan() {
	read input
	local dev=$(echo "$input" | jsonfilter -e '@.device' 2>/dev/null)
	local ath="ath0"
	local rdev="wifi0"
	local def_nf=-95
	case "$dev" in
		wifi0|ath0*) ath="ath0"; rdev="wifi0"; def_nf=-95 ;;
		wifi1|ath1*) ath="ath1"; rdev="wifi1"; def_nf=-102 ;;
		wifi2|ath2*) ath="ath2"; rdev="wifi2"; def_nf=-99 ;;
	esac

	local nf=$(cfg80211tool "$ath" get_channf 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9-')
	[ -z "$nf" ] || [ "$nf" -ge 0 ] 2>/dev/null && nf="$def_nf"

	iw dev "$ath" scan ap-force >/dev/null 2>&1 || iw dev "$ath" scan >/dev/null 2>&1 || true
	local raw_scan="/tmp/luci_scan_${ath}.raw"
	iw dev "$ath" scan dump 2>/dev/null > "$raw_scan"

	printf '{"results":['
	awk -v nf="$nf" '
	function freq_to_ch(f) {
		if (f >= 2412 && f <= 2484) {
			if (f == 2484) return 14
			return int((f - 2407) / 5)
		} else if (f >= 5000 && f <= 5900) {
			return int((f - 5000) / 5)
		} else if (f >= 5925 && f <= 7125) {
			return int((f - 5950) / 5)
		}
		return 1
	}
	function flush_bss() {
		if (!in_bss || bss == "") return
		if (ssid ~ /^(\\x00)+$/ || ssid ~ /^[ \t]*$/) ssid_json = "null"
		else {
			gsub(/\\/, "\\\\", ssid)
			gsub(/"/, "\\\"", ssid)
			ssid_json = "\"" ssid "\""
		}
		ch = freq_to_ch(freq)
		if (sig <= -100) qual = 0
		else if (sig >= -50) qual = 100
		else qual = 2 * (sig + 100)

		if (is_sae && is_psk) {
			enc_json = "{\"enabled\":true,\"wpa\":[2,3],\"authentication\":[\"psk\",\"sae\"],\"ciphers\":[\"ccmp\"]}"
		} else if (is_sae) {
			enc_json = "{\"enabled\":true,\"wpa\":[3],\"authentication\":[\"sae\"],\"ciphers\":[\"ccmp\"]}"
		} else if (is_rsn && is_wpa) {
			enc_json = "{\"enabled\":true,\"wpa\":[1,2],\"authentication\":[\"psk\"],\"ciphers\":[\"tkip\",\"ccmp\"]}"
		} else if (is_rsn) {
			enc_json = "{\"enabled\":true,\"wpa\":[2],\"authentication\":[\"psk\"],\"ciphers\":[\"ccmp\"]}"
		} else if (is_wpa) {
			enc_json = "{\"enabled\":true,\"wpa\":[1],\"authentication\":[\"psk\"],\"ciphers\":[\"tkip\"]}"
		} else {
			enc_json = "{\"enabled\":false}"
		}

		if (freq > 5900 && gen == "Wi-Fi 6") gen = "Wi-Fi 6E"

		if (!seen[bss]++) {
			if (!first) printf ","
			first = 0
			printf "{\"ssid\":%s,\"bssid\":\"%s\",\"mode\":\"Master\",\"channel\":%d,\"mhz\":%d,\"bw\":\"%s\",\"gen\":\"%s\",\"signal\":%d,\"noise\":%d,\"quality\":%d,\"quality_max\":100,\"encryption\":%s}", \
				ssid_json, bss, ch, freq, bw, gen, sig, nf, qual, enc_json
		}
	}
	BEGIN { in_bss = 0; first = 1 }
	/^BSS / {
		flush_bss()
		in_bss = 1
		sub(/\(.*/, "", $2)
		bss = toupper($2)
		ssid = ""
		freq = 0
		sig = -85
		is_wpa = 0
		is_rsn = 0
		is_sae = 0
		is_psk = 0
		bw = "20 MHz"
		gen = "Wi-Fi 4"
	}
	/^[ \t]*freq:/ { freq = int($2) }
	/^[ \t]*signal:/ { sig = int($2) }
	/^[ \t]*SSID: / {
		sub(/^[ \t]*SSID: /, "")
		ssid = $0
	}
	/^[ \t]*WPA:/ { is_wpa = 1; is_psk = 1 }
	/^[ \t]*RSN:/ { is_rsn = 1 }
	/Authentication suites:.*SAE/ { is_sae = 1 }
	/Authentication suites:.*PSK/ { is_psk = 1 }
	/secondary channel offset: (above|below)/ {
		if (bw == "20 MHz") bw = "40 MHz"
	}
	/VHT capabilities:/ {
		if (gen == "Wi-Fi 4") gen = "Wi-Fi 5"
	}
	/channel width: 1 \(80 MHz\)/ {
		if (freq >= 5000 && (bw == "20 MHz" || bw == "40 MHz")) bw = "80 MHz"
	}
	/channel width: [23] \((160|80\+80)/ {
		if (freq >= 5000) bw = "160 MHz"
	}
	/center freq segment 2: [1-9]/ {
		if (freq >= 5000 && bw == "80 MHz") bw = "160 MHz"
	}
	/HE capabilities:|HE MAC Capabilities/ {
		if (gen != "Wi-Fi 7") gen = "Wi-Fi 6"
	}
	/EHT capabilities:|EHT MAC Capabilities/ {
		gen = "Wi-Fi 7"
	}
	/320 MHz/ {
		if (in_bss && freq >= 5000) bw = "320 MHz"
	}
	END { flush_bss() }
	' "$raw_scan" 2>/dev/null
	printf ']}\n'
}

do_luci_wifi_action() {
	read input
	local act=$(echo "$input" | jsonfilter -e '@.action' 2>/dev/null)
	local dev=$(echo "$input" | jsonfilter -e '@.device' 2>/dev/null)
	local mac=$(echo "$input" | jsonfilter -e '@.mac' 2>/dev/null)

	case "$act" in
		restart_radio)
			if [ -n "$dev" ]; then
				( /sbin/wifi up "$dev" >/dev/null 2>&1; /etc/init.d/predator_rf start >/dev/null 2>&1 ) &
			else
				( /sbin/wifi reload >/dev/null 2>&1; /etc/init.d/predator_rf start >/dev/null 2>&1 ) &
			fi
			echo '{"success":true,"action":"restart_radio"}'
			;;
		disconnect_client)
			local rdev="wifi0"
			case "$dev" in
				ath1*|wifi1*) rdev="wifi1"; [ "$dev" = "wifi1" ] && dev="ath1" ;;
				ath2*|wifi2*) rdev="wifi2"; [ "$dev" = "wifi2" ] && dev="ath2" ;;
				*) [ "$dev" = "wifi0" ] && dev="ath0" ;;
			esac
			if [ -n "$mac" ]; then
				hostapd_cli -p "/var/run/hostapd-$rdev" -i "$dev" deauthenticate "$mac" >/dev/null 2>&1 || true
				cfg80211tool "$dev" kickmac "$mac" >/dev/null 2>&1 || true
			fi
			echo '{"success":true,"action":"disconnect_client"}'
			;;
		reload|*)
			# Synchronize QSDK wireless invariants before reloading
			for sec in $(uci show wireless 2>/dev/null | grep '=wifi-iface' | cut -d'.' -f2 | cut -d'=' -f1); do
				local k=$(uci -q get wireless.$sec.key)
				local enc=$(uci -q get wireless.$sec.encryption)
				local r=$(uci -q get wireless.$sec.device)
				if [ -n "$k" ]; then
					uci set wireless.$sec.sae_password="$k"
				fi
				case "$enc" in
					sae)
						uci set wireless.$sec.sae='1'
						uci set wireless.$sec.ieee80211w='2'
						;;
					sae-mixed)
						uci set wireless.$sec.sae='1'
						uci set wireless.$sec.ieee80211w='1'
						;;
					psk2*|psk*)
						if [ "$r" != "wifi2" ]; then
							uci set wireless.$sec.sae='0'
						fi
						;;
				esac
			done
			# Check wifi1 HT240 invariants
			if [ "$(uci -q get wireless.wifi1.htmode)" = "HT240" ]; then
				local ch1=$(uci -q get wireless.wifi1.channel)
				if [ -z "$ch1" ] || [ "$ch1" = "auto" ] || [ "$ch1" -lt 100 ] 2>/dev/null || [ "$ch1" -gt 144 ] 2>/dev/null; then
					uci set wireless.wifi1.channel='100'
				fi
				uci set wireless.wifi1.ccfs='130'
				uci set wireless.wifi1.puncture_bitmap='61440'
				uci set wireless.wifi1.puncture_strict='0'
				uci set wireless.wifi1.dfs_punctureEn='1'
				uci set wireless.wifi1_ap.cactimeout='1'
			else
				uci set wireless.wifi1.ccfs='0'
				uci set wireless.wifi1.puncture_bitmap='0'
			fi
			uci commit wireless
			mkdir -p /etc/predator
			cp /etc/config/wireless /etc/predator/wireless.lastgood 2>/dev/null || true
			( /sbin/wifi reload >/dev/null 2>&1; /etc/init.d/predator_rf start >/dev/null 2>&1 ) &
			echo '{"success":true,"action":"reload"}'
			;;
	esac
}

do_run_net_diag() {
	read input
	local mode=$(echo "$input" | jsonfilter -e '@.mode' 2>/dev/null)
	local target=$(echo "$input" | jsonfilter -e '@.target' 2>/dev/null | tr -cd 'a-zA-Z0-9._:-')
	local size=$(echo "$input" | jsonfilter -e '@.size' 2>/dev/null | tr -cd '0-9')
	[ -z "$target" ] && target="1.1.1.1"
	[ -z "$size" ] && size="1500"
	[ "$size" -lt 576 ] 2>/dev/null && size="576"
	[ "$size" -gt 1500 ] 2>/dev/null && size="1500"

	local mtu_fix="1"
	case "$mode" in
		pmtu)
			local rt_line=$(ip route get "$target" 2>/dev/null | head -n1)
			local wan_dev=$(echo "$rt_line" | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}')
			[ -z "$wan_dev" ] && wan_dev="br-lan"
			local wan_mtu=$(cat "/sys/class/net/$wan_dev/mtu" 2>/dev/null | tr -cd '0-9')
			[ -z "$wan_mtu" ] && wan_mtu="1500"

			local raw_tp=""
			local pmtu_val="$wan_mtu"
			if [ -z "$rt_line" ] || echo "$rt_line" | grep -q "unreachable"; then
				raw_tp=$(
					echo "=== DIAGNOSTICO LOCAL PMTU (WAN desconectada no momento) ==="
					echo "Alvo solicitado : $target (Pacote inicial: $size bytes)"
					echo "Status da WAN   : Sem rota externa ativa (testando pilha local br-lan 192.168.76.1)"
					echo "TCP MSS Clamping: ATIVO (mtu_fix=1 | IPv4 MSS 1452 / IPv6 MSS 1432)"
					echo ""
					tracepath -n -m 3 -l "$size" 192.168.76.1 2>&1
				)
				pmtu_val="$wan_mtu"
			else
				raw_tp=$(
					echo "=== TRACEPATH PMTU DISCOVERY (iputils v20210202) ==="
					echo "Alvo: $target | Interface de Saida: $wan_dev (MTU $wan_mtu) | Pacote Inicial: $size bytes (DF=1)"
					echo "TCP MSS Clamping: ATIVO (mtu_fix=1 | Protecao Automatica Anti-Fragmentacao)"
					echo ""
					tracepath -n -m 8 -l "$size" "$target" 2>&1
				)
				local det_pmtu=$(echo "$raw_tp" | awk '/pmtu [0-9]+/{for(i=1;i<=NF;i++) if($i=="pmtu") p=$(i+1)} END{print p}' | tr -cd '0-9')
				if [ -n "$det_pmtu" ] && [ "$det_pmtu" -le 1500 ] 2>/dev/null && [ "$det_pmtu" -ge 576 ] 2>/dev/null; then
					pmtu_val="$det_pmtu"
				fi
			fi

			local esc_out=$(printf '%s' "$raw_tp" | awk '{gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\r/,""); gsub(/\t/,"  "); printf "%s\\n", $0}')
			printf '{"success":true,"mode":"pmtu","target":"%s","size":"%s","pmtu":"%s","wan_dev":"%s","wan_mtu":"%s","mtu_fix":"%s","output":"%s"}\n' \
				"$target" "$size" "$pmtu_val" "$wan_dev" "$wan_mtu" "$mtu_fix" "$esc_out"
			;;
		ethtool)
			local raw_eth=$(
				echo "=== PORTA WAN 2.5G (eth0 - ethtool v5.10 NBASE-T) ==="
				ethtool eth0 2>&1
				echo ""
				echo "=== ACELERACAO & OFFLOADS DE HARDWARE (eth0 GSO/GRO/TSO/SG) ==="
				ethtool -k eth0 2>&1 | grep -E "scatter-gather|tcp-segmentation-offload|generic-segmentation-offload|generic-receive-offload|rx-checksumming|tx-checksumming"
				echo ""
				echo "=== INTERFACES ETHERNET & BRIDGES (MTU & ESTADO) ==="
				for d in eth0 eth1 br-lan br-guest br-iot wg0; do
					[ -d "/sys/class/net/$d" ] && printf "%-10s : state=%-8s mtu=%-5s speed=%s Mbps\n" "$d" "$(cat /sys/class/net/$d/operstate 2>/dev/null)" "$(cat /sys/class/net/$d/mtu 2>/dev/null)" "$(cat /sys/class/net/$d/speed 2>/dev/null || echo 'N/A')"
				done
			)
			local esc_eth=$(printf '%s' "$raw_eth" | awk '{gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\r/,""); gsub(/\t/,"  "); printf "%s\\n", $0}')
			printf '{"success":true,"mode":"ethtool","output":"%s"}\n' "$esc_eth"
			;;
		iperf_start)
			killall iperf 2>/dev/null || true
			iperf -s -D -p 5001 >/dev/null 2>&1 &
			sleep 1
			local ip_run="0"
			[ -n "$(pidof iperf)" ] && ip_run="1"
			local ip_ver=$(iperf -v 2>&1 | head -n1 | tr -d '\r\n"')
			printf '{"success":true,"mode":"iperf_start","iperf_running":"%s","version":"%s","output":"Servidor %s ativo na porta TCP/UDP 5001!\\n\\nPara testar a velocidade maxima Multi-Thread (Wi-Fi 7 ou Cabo 2.5G) a partir do seu PC/Mac:\\n  iperf -c 192.168.76.1 -P 4 -t 10 -e"}\n' \
				"$ip_run" "$ip_ver" "$ip_ver"
			;;
		iperf_stop)
			killall -9 iperf 2>/dev/null || true
			printf '{"success":true,"mode":"iperf_stop","iperf_running":"0","output":"Servidor iperf (porta 5001) encerrado."}\n'
			;;
		*)
			echo '{"success":false,"error":"unknown_mode"}'
			;;
	esac
}

