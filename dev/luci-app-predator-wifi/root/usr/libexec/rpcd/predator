do_edit_vif() {
	read input
	SEC=$(echo "$input" | jsonfilter -e '@.section')
	SSID=$(echo "$input" | jsonfilter -e '@.ssid')
	KEY=$(echo "$input" | jsonfilter -e '@.key')
	ENC=$(echo "$input" | jsonfilter -e '@.encryption')
	[ -z "$SEC" ] && { echo '{"success":false,"error":"section_empty"}'; exit 0; }
	[ -z "$SSID" ] && { echo '{"success":false,"error":"ssid_empty"}'; exit 0; }
	[ ${#SSID} -gt 32 ] && { echo '{"success":false,"error":"ssid_too_long"}'; exit 0; }

	local dev_v=$(uci -q get wireless.$SEC.device)
	if [ "$dev_v" = "wifi2" ]; then
		[ "$ENC" = "psk2" ] || [ "$ENC" = "psk2+aes" ] || [ "$ENC" = "sae-mixed" ] && ENC="sae"
		[ "$ENC" = "none" ] && ENC="owe"
	fi

	# Se a senha veio vazia na edicao, puxa a senha existente (requisito do usuario)
	if [ -z "$KEY" ]; then
		KEY=$(uci -q get wireless.$SEC.key || uci -q get wireless.$SEC.sae_password)
	fi

	# Se for rede protegida e mesmo assim nao tem senha, nao aplica
	if [ "$ENC" != "none" ] && [ "$ENC" != "owe" ]; then
		if [ -z "$KEY" ]; then
			echo '{"success":false,"error":"key_required"}'
			exit 0
		fi
		if [ ${#KEY} -lt 8 ] || [ ${#KEY} -gt 63 ]; then
			echo '{"success":false,"error":"key_invalid"}'
			exit 0
		fi
	fi

	[ -n "$SSID" ] && uci set wireless.$SEC.ssid="$SSID"
	[ -n "$ENC" ] && uci set wireless.$SEC.encryption="$ENC"
	
	if [ "$ENC" = "sae" ]; then
		uci set wireless.$SEC.sae='1'
		uci set wireless.$SEC.owe='0'
		uci set wireless.$SEC.ieee80211w='2'
	elif [ "$ENC" = "sae-mixed" ]; then
		uci set wireless.$SEC.sae='1'
		uci set wireless.$SEC.owe='0'
		uci set wireless.$SEC.ieee80211w='1'
	elif [ "$ENC" = "owe" ]; then
		uci set wireless.$SEC.owe='1'
		uci set wireless.$SEC.sae='0'
		uci set wireless.$SEC.ieee80211w='2'
		uci -q delete wireless.$SEC.key
		uci -q delete wireless.$SEC.sae_password
	elif [ "$ENC" = "none" ]; then
		uci set wireless.$SEC.owe='0'
		uci set wireless.$SEC.sae='0'
		uci set wireless.$SEC.ieee80211w='0'
		uci -q delete wireless.$SEC.key
		uci -q delete wireless.$SEC.sae_password
	elif [ "$ENC" = "psk2" ] || [ "$ENC" = "psk2+aes" ]; then
		uci set wireless.$SEC.encryption='psk2+aes'
		uci set wireless.$SEC.owe='0'
		uci set wireless.$SEC.sae='0'
		uci set wireless.$SEC.ieee80211w='0'
	fi

	if [ "$ENC" != "none" ] && [ "$ENC" != "owe" ] && [ -n "$KEY" ]; then
		uci set wireless.$SEC.key="$KEY"
		uci set wireless.$SEC.sae_password="$KEY"
	fi

	uci set wireless.$SEC.wds='1'
	uci set wireless.$SEC.rrm='1'
	uci set wireless.$SEC.bss_transition='1'
	uci set wireless.$SEC.rrm_neighbor_report='1'
	uci set wireless.$SEC.rrm_beacon_report='1'
	uci set wireless.$SEC.wnm_sleep_mode='1'
	if [ "$dev_v" = "wifi2" ]; then
		uci set wireless.$SEC.en_6g_sec_comp='0'
		uci set wireless.$SEC.ieee80211ai='1'
		uci set wireless.$SEC.fils_fd_period='20'
	fi

	uci commit wireless
	[ -x /usr/sbin/predator-wifi-guard ] && /usr/sbin/predator-wifi-guard fix
	rm -f /var/run/*lock* 2>/dev/null; ( sleep 1; wifi reload; [ -x /usr/sbin/predator-wifi-guard ] && ( /usr/sbin/predator-wifi-guard verify >/dev/null 2>&1 ) & ) &
	echo '{ "success": true }'
}

do_add_vif() {
	read input
	SSID=$(echo "$input" | jsonfilter -e '@.ssid')
	KEY=$(echo "$input" | jsonfilter -e '@.key')
	ENC=$(echo "$input" | jsonfilter -e '@.encryption')
	B2G=$(echo "$input" | jsonfilter -e '@.band_2g')
	B5G=$(echo "$input" | jsonfilter -e '@.band_5g')
	B6G=$(echo "$input" | jsonfilter -e '@.band_6g')
	GUEST=$(echo "$input" | jsonfilter -e '@.is_guest')
	IOT=$(echo "$input" | jsonfilter -e '@.is_iot')
	ZONE=$(echo "$input" | jsonfilter -e '@.zone')
	IS_MLD=$(echo "$input" | jsonfilter -e '@.is_mld')

	[ -z "$SSID" ] && { echo '{"success":false,"error":"ssid_empty"}'; exit 0; }
	[ ${#SSID} -gt 32 ] && { echo '{"success":false,"error":"ssid_too_long"}'; exit 0; }
	[ -z "$ENC" ] && ENC="sae-mixed"

	if [ "$ENC" != "none" ] && [ "$ENC" != "owe" ]; then
		if [ -z "$KEY" ]; then
			echo '{"success":false,"error":"key_required"}'
			exit 0
		fi
		if [ ${#KEY} -lt 8 ] || [ ${#KEY} -gt 63 ]; then
			echo '{"success":false,"error":"key_invalid"}'
			exit 0
		fi
	fi

	net_zone="lan"
	isolate_val="0"
	if [ "$ZONE" = "iot" ] || [ "$IOT" = "true" ] || [ "$IOT" = "1" ]; then
		net_zone="iot"
		isolate_val="1"
	elif [ "$ZONE" = "guest" ] || [ "$GUEST" = "true" ] || [ "$GUEST" = "1" ]; then
		net_zone="guest"
		isolate_val="1"
	fi

	# VAPs adicionais (redes secundarias) operam com maxima estabilidade
	# em modo multi-banda padrao (a versao atual do driver QCA SPF-12 opera com
	# mlo_mbssid desabilitado por perfil de software, e o daemon predator administra mld0 na rede principal).
	ts=$(date +%s)
	if [ "$B2G" = "true" ] || [ "$B2G" = "1" ]; then
		sid="vif_2g_${ts}"
		uci set wireless.$sid=wifi-iface
		uci set wireless.$sid.device='wifi0'
		uci set wireless.$sid.network="$net_zone"
		uci set wireless.$sid.mode='ap'
		uci set wireless.$sid.ssid="$SSID"
		uci set wireless.$sid.isolate="$isolate_val"
		uci set wireless.$sid.encryption="$ENC"
		if [ "$ENC" = "owe" ]; then
			uci set wireless.$sid.owe='1'
			uci set wireless.$sid.ieee80211w='2'
		elif [ "$ENC" != "none" ] && [ -n "$KEY" ]; then
			uci set wireless.$sid.key="$KEY"
			uci set wireless.$sid.sae_password="$KEY"
			[ "$ENC" = "sae" ] && uci set wireless.$sid.sae='1' && uci set wireless.$sid.ieee80211w='2'
			[ "$ENC" = "sae-mixed" ] && uci set wireless.$sid.sae='1' && uci set wireless.$sid.ieee80211w='1'
		fi
		uci set wireless.$sid.wds='1'
		uci set wireless.$sid.rrm='1'
		uci set wireless.$sid.bss_transition='1'
		uci set wireless.$sid.rrm_neighbor_report='1'
		uci set wireless.$sid.rrm_beacon_report='1'
		uci set wireless.$sid.wnm_sleep_mode='1'
	fi

	if [ "$B5G" = "true" ] || [ "$B5G" = "1" ]; then
		sid="vif_5g_${ts}"
		uci set wireless.$sid=wifi-iface
		uci set wireless.$sid.device='wifi1'
		uci set wireless.$sid.network="$net_zone"
		uci set wireless.$sid.mode='ap'
		uci set wireless.$sid.ssid="$SSID"
		uci set wireless.$sid.isolate="$isolate_val"
		uci set wireless.$sid.encryption="$ENC"
		if [ "$ENC" = "owe" ]; then
			uci set wireless.$sid.owe='1'
			uci set wireless.$sid.ieee80211w='2'
		elif [ "$ENC" != "none" ] && [ -n "$KEY" ]; then
			uci set wireless.$sid.key="$KEY"
			uci set wireless.$sid.sae_password="$KEY"
			[ "$ENC" = "sae" ] && uci set wireless.$sid.sae='1' && uci set wireless.$sid.ieee80211w='2'
			[ "$ENC" = "sae-mixed" ] && uci set wireless.$sid.sae='1' && uci set wireless.$sid.ieee80211w='1'
		fi
		uci set wireless.$sid.wds='1'
		uci set wireless.$sid.rrm='1'
		uci set wireless.$sid.bss_transition='1'
		uci set wireless.$sid.rrm_neighbor_report='1'
		uci set wireless.$sid.rrm_beacon_report='1'
		uci set wireless.$sid.wnm_sleep_mode='1'
	fi

	if [ "$B6G" = "true" ] || [ "$B6G" = "1" ]; then
		sid="vif_6g_${ts}"
		uci set wireless.$sid=wifi-iface
		uci set wireless.$sid.device='wifi2'
		uci set wireless.$sid.network="$net_zone"
		uci set wireless.$sid.mode='ap'
		uci set wireless.$sid.ssid="$SSID"
		local enc6="$ENC"
		[ "$enc6" = "psk2" ] || [ "$enc6" = "psk2+aes" ] || [ "$enc6" = "sae-mixed" ] && enc6="sae"
		[ "$enc6" = "none" ] && enc6="owe"
		uci set wireless.$sid.encryption="$enc6"
		if [ "$enc6" = "owe" ]; then
			uci set wireless.$sid.owe='1'
			uci set wireless.$sid.ieee80211w='2'
		else
			uci set wireless.$sid.sae='1'
			uci set wireless.$sid.ieee80211w='2'
			if [ -n "$KEY" ]; then
				uci set wireless.$sid.key="$KEY"
				uci set wireless.$sid.sae_password="$KEY"
			fi
		fi
		uci set wireless.$sid.isolate="$isolate_val"
		uci set wireless.$sid.wds='1'
		uci set wireless.$sid.rrm='1'
		uci set wireless.$sid.bss_transition='1'
		uci set wireless.$sid.rrm_neighbor_report='1'
		uci set wireless.$sid.rrm_beacon_report='1'
		uci set wireless.$sid.wnm_sleep_mode='1'
		uci set wireless.$sid.en_6g_sec_comp='0'
		uci set wireless.$sid.ieee80211ai='1'
		uci set wireless.$sid.fils_fd_period='20'
	fi

	uci commit wireless
	[ -x /usr/sbin/predator-wifi-guard ] && /usr/sbin/predator-wifi-guard fix
	killall -9 lock 2>/dev/null
	rm -f /var/run/*lock* 2>/dev/null; ( sleep 1; wifi reload; [ -x /usr/sbin/predator-wifi-guard ] && ( /usr/sbin/predator-wifi-guard verify >/dev/null 2>&1 ) & ) &
	echo '{ "success": true }'
}

do_del_vif() {
	read input
	SEC=$(echo "$input" | jsonfilter -e '@.section')
	[ -z "$SEC" ] && exit 1
	if [ "$SEC" != "wifi0_ap" ] && [ "$SEC" != "wifi1_ap" ] && [ "$SEC" != "wifi2_ap" ]; then
		local del_ssid=$(uci -q get wireless.$SEC.ssid)
		if [ -n "$del_ssid" ]; then
			for s in $(uci show wireless | grep "\.ssid='$del_ssid'" | cut -d'.' -f2 | cut -d'=' -f1); do
				if [ "$s" != "wifi0_ap" ] && [ "$s" != "wifi1_ap" ] && [ "$s" != "wifi2_ap" ]; then
					uci -q delete wireless.$s
				fi
			done
		else
			uci -q delete wireless.$SEC
		fi
		uci commit wireless
		killall -9 lock 2>/dev/null
		rm -f /var/run/*lock* 2>/dev/null; ( sleep 1; wifi reload ) &
	fi
	echo '{ "success": true }'
}

do_toggle_vif() {
	read input
	SEC=$(echo "$input" | jsonfilter -e '@.section')
	DIS=$(echo "$input" | jsonfilter -e '@.disabled')
	[ -z "$SEC" ] && exit 1
	uci set wireless.$SEC.disabled="$DIS"
	uci commit wireless
	killall -9 lock 2>/dev/null
	rm -f /var/run/*lock* 2>/dev/null; ( sleep 1; wifi reload ) &
	echo '{ "success": true }'
}

do_restart_wifi() {
	killall -9 lock 2>/dev/null
	rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/*lock* 2>/dev/null
	(
		sleep 1
		killall hostapd 2>/dev/null
		killall -9 lock 2>/dev/null
		rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/*lock* 2>/dev/null
		/etc/init.d/qca-hostapd start 2>/dev/null
		sleep 1
		/sbin/wifi up 2>/dev/null
		sleep 2
		# Ensure all 3 primary VAPs exist, are bridged to br-lan, and hostapd is broadcasting
		PHY0=$(cat /sys/class/net/wifi0/phy80211/name 2>/dev/null || echo "phy5")
		PHY1=$(cat /sys/class/net/wifi1/phy80211/name 2>/dev/null || echo "phy6")
		PHY2=$(cat /sys/class/net/wifi2/phy80211/name 2>/dev/null || echo "phy7")
		[ -d /sys/class/net/ath0 ] || iw phy "$PHY0" interface add ath0 type __ap 2>/dev/null
		[ -d /sys/class/net/ath1 ] || iw phy "$PHY1" interface add ath1 type __ap 2>/dev/null
		[ -d /sys/class/net/ath2 ] || iw phy "$PHY2" interface add ath2 type __ap 2>/dev/null
		brctl addif br-lan ath0 2>/dev/null; ifconfig ath0 up 2>/dev/null
		brctl addif br-lan ath1 2>/dev/null; ifconfig ath1 up 2>/dev/null
		brctl addif br-lan ath2 2>/dev/null; ifconfig ath2 up 2>/dev/null
		if [ "$(uci -q get tripleband.tripleband.mlo_enable)" = "1" ] || [ -n "$(uci -q get wireless.mld0)" ]; then
			[ -d /sys/class/net/mld0 ] && { brctl addif br-lan mld0 2>/dev/null; ifconfig mld0 up 2>/dev/null; }
		fi
		[ -S /var/run/hostapd-wifi0/ath0 ] || hostapd -B -P /var/run/hostapd-ath0.pid /var/run/hostapd-ath0.conf 2>/dev/null
		[ -S /var/run/hostapd-wifi1/ath1 ] || hostapd -B -P /var/run/hostapd-ath1.pid /var/run/hostapd-ath1.conf 2>/dev/null
		[ -S /var/run/hostapd-wifi2/ath2 ] || hostapd -B -P /var/run/hostapd-ath2.pid /var/run/hostapd-ath2.conf 2>/dev/null
		[ -x /lib/wifi_hardware_tune.sh ] && /lib/wifi_hardware_tune.sh
		killall -9 lock 2>/dev/null
		rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/*lock* 2>/dev/null
	) &
	echo '{ "success": true }'
}

do_toggle_radio() {
	read input
	DEV=$(echo "$input" | jsonfilter -e '@.device')
	DIS=$(echo "$input" | jsonfilter -e '@.disabled')
	[ -z "$DEV" ] && exit 1
	uci set wireless.$DEV.disabled="$DIS"
	uci commit wireless
	killall -9 lock 2>/dev/null
	rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/*lock* 2>/dev/null
	( sleep 1; /sbin/wifi up 2>/dev/null; killall -9 lock 2>/dev/null; rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/*lock* 2>/dev/null ) &
	echo '{ "success": true }'
}

do_toggle_feature() {
	read input
	FEAT=$(echo "$input" | jsonfilter -e '@.feature')
	VAL=$(echo "$input" | jsonfilter -e '@.value')
	[ -z "$FEAT" ] && exit 1
	[ -z "$VAL" ] && VAL="1"

	case "$FEAT" in
		gaming)
			cfg80211tool wifi0 low_latency_mode "$VAL" 2>/dev/null || true
			cfg80211tool wifi1 low_latency_mode "$VAL" 2>/dev/null || true
			cfg80211tool wifi2 low_latency_mode "$VAL" 2>/dev/null || true
			uci set tripleband.tripleband.gaming_mode="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		ani)
			cfg80211tool wifi0 ani_enable "$VAL" 2>/dev/null || true
			cfg80211tool wifi1 ani_enable "$VAL" 2>/dev/null || true
			cfg80211tool wifi2 ani_enable "$VAL" 2>/dev/null || true
			uci set tripleband.tripleband.ani_enable="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		rnr_6g)
			if [ "$VAL" = "1" ]; then
				cfg80211tool wifi0 rnr_6ghz_colocated 1 7 2>/dev/null || true
				cfg80211tool wifi1 rnr_6ghz_colocated 1 7 2>/dev/null || true
				cfg80211tool wifi2 rnr_member_ess_colocated_en 1 2>/dev/null || true
				cfg80211tool ath2 enable_fils 1 20 2>/dev/null || true
			else
				cfg80211tool wifi0 rnr_6ghz_colocated 0 7 2>/dev/null || true
				cfg80211tool wifi1 rnr_6ghz_colocated 0 7 2>/dev/null || true
				cfg80211tool wifi2 rnr_member_ess_colocated_en 0 2>/dev/null || true
				cfg80211tool ath2 enable_fils 0 20 2>/dev/null || true
			fi
			uci set tripleband.tripleband.rnr_colocated="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		qam4096)
			# Toggle Wi-Fi 7 (4096-QAM / 11bea + HT320) vs Wi-Fi 6E (1024-QAM / 11axa + HT160)
			if [ "$VAL" = "1" ]; then
				uci set wireless.wifi2.hwmode='11bea'
				[ "$(uci -q get wireless.wifi2.htmode)" = "HT160" ] && uci set wireless.wifi2.htmode='HT320'
			else
				uci set wireless.wifi2.hwmode='11axa'
				[ "$(uci -q get wireless.wifi2.htmode)" = "HT320" ] && uci set wireless.wifi2.htmode='HT160'
			fi
			uci commit wireless
			( sleep 1; wifi reload; sleep 2; [ -d /sys/class/net/mld0 ] && { brctl addif br-lan mld0 2>/dev/null; ifconfig mld0 up 2>/dev/null; } ) &
			;;
		rps)
			if [ "$VAL" = "1" ]; then
				mask="f"
			else
				mask="1"
			fi
			for q in /sys/class/net/*/queues/rx-*/rps_cpus; do
				[ -f "$q" ] && echo "$mask" > "$q" 2>/dev/null || true
			done
			uci set tripleband.tripleband.rps_quadcore="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		puncturing)
			cfg80211tool wifi1 puncture_strict "$VAL" 2>/dev/null || true
			cfg80211tool wifi2 puncture_strict "$VAL" 2>/dev/null || true
			uci set tripleband.tripleband.puncturing="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		beamforming)
			if [ "$VAL" = "1" ]; then
				snd=100
			else
				snd=0
			fi
			cfg80211tool wifi0 txbf_snd_int "$snd" 2>/dev/null || true
			cfg80211tool wifi1 txbf_snd_int "$snd" 2>/dev/null || true
			cfg80211tool wifi2 txbf_snd_int "$snd" 2>/dev/null || true
			uci set tripleband.tripleband.beamforming="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
	esac
	echo "{ \"success\": true, \"feature\": \"$FEAT\", \"value\": \"$VAL\" }"
}

do_get_guard_status() {
	if [ -x /usr/sbin/predator-wifi-guard ]; then
		/usr/sbin/predator-wifi-guard status
	else
		echo '{"rollback_ts":"","rollback_kind":"","rollback_reason":"","fixes":[]}'
	fi
}

do_ack_guard() {
	[ -x /usr/sbin/predator-wifi-guard ] && /usr/sbin/predator-wifi-guard ack
	echo '{"success":true}'
}

case "$1" in
	list)
		echo '{ "get_status": {}, "get_guard_status": {}, "ack_guard": {}, "set_telnet": { "enabled": "string" }, "apply_topology": { "mode": "string", "ssid": "string", "key": "string", "ssid_6g": "string" }, "set_radio": { "device": "string", "channel": "string", "htmode": "string", "txpower": "string" }, "set_all_radios": { "wifi0": "table", "wifi1": "table", "wifi2": "table" }, "edit_vif": { "section": "string", "ssid": "string", "key": "string", "encryption": "string" }, "add_vif": { "ssid": "string", "key": "string", "encryption": "string", "band_2g": "bool", "band_5g": "bool", "band_6g": "bool", "is_guest": "bool", "is_mld": "bool" }, "del_vif": { "section": "string" }, "toggle_vif": { "section": "string", "disabled": "string" }, "restart_wifi": {}, "toggle_radio": { "device": "string", "disabled": "string" }, "toggle_feature": { "feature": "string", "value": "string" } }'
		;;
	call)
		case "$2" in
			get_status) do_get_status ;;
			get_guard_status) do_get_guard_status ;;
			ack_guard) do_ack_guard ;;
			set_telnet) do_set_telnet ;;
			apply_topology) do_apply_topology ;;
			set_radio) do_set_radio ;;
			set_all_radios) do_set_all_radios ;;
			edit_vif) do_edit_vif ;;
			add_vif) do_add_vif ;;
			del_vif) do_del_vif ;;
			toggle_vif) do_toggle_vif ;;
			restart_wifi) do_restart_wifi ;;
			toggle_radio) do_toggle_radio ;;
			toggle_feature) do_toggle_feature ;;
		esac
		;;
esac


