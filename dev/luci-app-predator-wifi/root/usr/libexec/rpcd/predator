	printf '}\n'
}

do_apply_topology() {
	read input
	MODE=$(echo "$input" | jsonfilter -e '@.mode')
	SSID=$(echo "$input" | jsonfilter -e '@.ssid')
	KEY=$(echo "$input" | jsonfilter -e '@.key')
	SSID6=$(echo "$input" | jsonfilter -e '@.ssid_6g')
	[ -z "$SSID" ] && { echo '{"success":false,"error":"ssid_empty"}'; exit 0; }
	[ ${#SSID} -gt 32 ] && { echo '{"success":false,"error":"ssid_too_long"}'; exit 0; }
	[ -z "$KEY" ] && KEY=$(uci -q get wireless.wifi0_ap.key || uci -q get wireless.wifi1_ap.key || uci -q get wireless.wifi2_ap.key || echo "123456789")
	if [ ${#KEY} -lt 8 ] || [ ${#KEY} -gt 63 ]; then
		echo '{"success":false,"error":"key_invalid"}'
		exit 0
	fi
	BASE_MAC=$(cat /sys/class/net/eth0/address 2>/dev/null || cat /sys/class/net/ath0/address 2>/dev/null || echo "70:5A:6F:5D:71:72")

	# Garantir que as 3 interfaces base existam mesmo se tiverem sido excluidas no LuCI nativo
	for idx in 0 1 2; do
		local v="wifi${idx}_ap"
		uci set wireless.$v=wifi-iface
		uci set wireless.$v.device="wifi${idx}"
		[ -z "$(uci -q get wireless.$v.network)" ] && uci set wireless.$v.network='lan'
		uci set wireless.$v.mode='ap'
		[ -z "$(uci -q get wireless.$v.disabled)" ] && uci set wireless.$v.disabled='0'
		uci set wireless.$v.isbasic='1'
		[ "$idx" = "0" ] && uci set wireless.$v.maxsta='128' || uci set wireless.$v.maxsta='64'
		uci set wireless.$v.wps_state='2'
		uci set wireless.$v.wps_pbc='1'
		uci set wireless.$v.wps_mode='PBC'
	done

	if [ "$MODE" = "speed_max" ]; then
		uci -q delete wireless.mld0
		uci -q delete wireless.wifi0_ap.mld
		uci -q delete wireless.wifi1_ap.mld
		uci -q delete wireless.wifi2_ap.mld

		uci set wireless.wifi0_ap.ssid="$SSID"
		uci set wireless.wifi0_ap.encryption='psk2+aes'
		uci -q delete wireless.wifi0_ap.sae
		uci -q delete wireless.wifi0_ap.ieee80211w
		uci set wireless.wifi1_ap.ssid="$SSID"
		uci set wireless.wifi1_ap.encryption='psk2+aes'
		uci -q delete wireless.wifi1_ap.sae
		uci -q delete wireless.wifi1_ap.ieee80211w

		local s6="${SSID6:-${SSID}_6GHz}"
		uci set wireless.wifi2_ap.ssid="$s6"
		uci set wireless.wifi2_ap.encryption='sae'
		uci set wireless.wifi2_ap.sae='1'
		uci set wireless.wifi2_ap.ieee80211w='2'

		if [ -n "$KEY" ]; then
			uci set wireless.wifi0_ap.key="$KEY"
			uci set wireless.wifi0_ap.sae_password="$KEY"
			uci set wireless.wifi1_ap.key="$KEY"
			uci set wireless.wifi1_ap.sae_password="$KEY"
			uci set wireless.wifi2_ap.key="$KEY"
			uci set wireless.wifi2_ap.sae_password="$KEY"
		fi

		uci set tripleband.tripleband.tripleband_basic='0'
		uci set tripleband.tripleband.mlo_enable='0'
		uci commit tripleband

	elif [ "$MODE" = "mlo_turbo" ]; then
		uci -q delete wireless.mld0
		uci set wireless.mld0=wifi-mld
		uci set wireless.mld0.mld_ref='0'
		uci set wireless.mld0.role='AP'
		uci set wireless.mld0.mld_ssid="$SSID"
		uci set wireless.mld0.mld_macaddr="$BASE_MAC"

		uci -q delete wireless.wifi0_ap.mld
		uci set wireless.wifi0_ap.ssid="${SSID}_2.4GHz"
		uci set wireless.wifi0_ap.encryption='psk2+aes'
		uci -q delete wireless.wifi0_ap.sae
		uci -q delete wireless.wifi0_ap.ieee80211w

		uci set wireless.wifi1_ap.ssid="$SSID"
		uci set wireless.wifi1_ap.mld='mld0'
		uci set wireless.wifi1_ap.encryption='sae'
		uci set wireless.wifi1_ap.sae='1'
		uci set wireless.wifi1_ap.ieee80211w='2'

		uci set wireless.wifi2_ap.ssid="$SSID"
		uci set wireless.wifi2_ap.mld='mld0'
		uci set wireless.wifi2_ap.encryption='sae'
		uci set wireless.wifi2_ap.sae='1'
		uci set wireless.wifi2_ap.ieee80211w='2'

		if [ -n "$KEY" ]; then
			uci set wireless.wifi0_ap.key="$KEY"
			uci set wireless.wifi0_ap.sae_password="$KEY"
			uci set wireless.wifi1_ap.key="$KEY"
			uci set wireless.wifi1_ap.sae_password="$KEY"
			uci set wireless.wifi2_ap.key="$KEY"
			uci set wireless.wifi2_ap.sae_password="$KEY"
		fi

		uci set tripleband.tripleband.tripleband_basic='1'
		uci set tripleband.tripleband.mlo_enable='1'
		uci set tripleband.tripleband.mlo_bands='0'
		uci set tripleband.tripleband.basic_ssid="$SSID"
		[ -n "$KEY" ] && uci set tripleband.tripleband.basic_key="$KEY"
		uci commit tripleband

	elif [ "$MODE" = "mlo_full" ]; then
		uci -q delete wireless.mld0
		uci set wireless.mld0=wifi-mld
		uci set wireless.mld0.mld_ref='0'
		uci set wireless.mld0.role='AP'
		uci set wireless.mld0.mld_ssid="$SSID"
		uci set wireless.mld0.mld_macaddr="$BASE_MAC"

		uci set wireless.wifi0_ap.ssid="$SSID"
		uci set wireless.wifi0_ap.mld='mld0'
		uci set wireless.wifi0_ap.encryption='sae'
		uci set wireless.wifi0_ap.sae='1'
		uci set wireless.wifi0_ap.ieee80211w='2'

		uci set wireless.wifi1_ap.ssid="$SSID"
		uci set wireless.wifi1_ap.mld='mld0'
		uci set wireless.wifi1_ap.encryption='sae'
		uci set wireless.wifi1_ap.sae='1'
		uci set wireless.wifi1_ap.ieee80211w='2'

		uci set wireless.wifi2_ap.ssid="$SSID"
		uci set wireless.wifi2_ap.mld='mld0'
		uci set wireless.wifi2_ap.encryption='sae'
		uci set wireless.wifi2_ap.sae='1'
		uci set wireless.wifi2_ap.ieee80211w='2'

		if [ -n "$KEY" ]; then
			uci set wireless.wifi0_ap.key="$KEY"
			uci set wireless.wifi0_ap.sae_password="$KEY"
			uci set wireless.wifi1_ap.key="$KEY"
			uci set wireless.wifi1_ap.sae_password="$KEY"
			uci set wireless.wifi2_ap.key="$KEY"
			uci set wireless.wifi2_ap.sae_password="$KEY"
		fi

		uci set tripleband.tripleband.tripleband_basic='1'
		uci set tripleband.tripleband.mlo_enable='1'
		uci set tripleband.tripleband.basic_ssid="$SSID"
		[ -n "$KEY" ] && uci set tripleband.tripleband.basic_key="$KEY"
		uci commit tripleband

	elif [ "$MODE" = "single_ssid" ]; then
		uci -q delete wireless.mld0
		uci -q delete wireless.wifi0_ap.mld
		uci -q delete wireless.wifi1_ap.mld
		uci -q delete wireless.wifi2_ap.mld

		# 2.4 GHz - WPA2-PSK puro (psk2+aes) para 100% dos dispositivos IoT
		uci set wireless.wifi0_ap.ssid="$SSID"
		uci set wireless.wifi0_ap.encryption='psk2+aes'
		uci -q delete wireless.wifi0_ap.sae
		uci -q delete wireless.wifi0_ap.ieee80211w

		# 5.0 GHz - WPA2/WPA3 Misto (sae-mixed) para ponte inteligente entre celulares e IoT
		uci set wireless.wifi1_ap.ssid="$SSID"
		uci set wireless.wifi1_ap.encryption='sae-mixed'
		uci set wireless.wifi1_ap.sae='1'
		uci set wireless.wifi1_ap.ieee80211w='1'

		# 6.0 GHz - WPA3-SAE puro (sae) com PMF obrigatório por norma internacional
		uci set wireless.wifi2_ap.ssid="$SSID"
		uci set wireless.wifi2_ap.encryption='sae'
		uci set wireless.wifi2_ap.sae='1'
		uci set wireless.wifi2_ap.ieee80211w='2'

		if [ -n "$KEY" ]; then
			uci set wireless.wifi0_ap.key="$KEY"
			uci set wireless.wifi0_ap.sae_password="$KEY"
			uci set wireless.wifi1_ap.key="$KEY"
			uci set wireless.wifi1_ap.sae_password="$KEY"
			uci set wireless.wifi2_ap.key="$KEY"
			uci set wireless.wifi2_ap.sae_password="$KEY"
		fi

		uci set tripleband.tripleband.tripleband_basic='0'
		uci set tripleband.tripleband.mlo_enable='0'
		uci commit tripleband

	else
		uci -q delete wireless.mld0
		uci -q delete wireless.wifi0_ap.mld
		uci -q delete wireless.wifi1_ap.mld
		uci -q delete wireless.wifi2_ap.mld

		uci set wireless.wifi0_ap.ssid="${SSID}_2.4GHz"
		uci set wireless.wifi0_ap.encryption='psk2+aes'
		uci -q delete wireless.wifi0_ap.sae
		uci -q delete wireless.wifi0_ap.ieee80211w

		uci set wireless.wifi1_ap.ssid="${SSID}_5GHz"
		uci set wireless.wifi1_ap.encryption='psk2+aes'
		uci -q delete wireless.wifi1_ap.sae
		uci -q delete wireless.wifi1_ap.ieee80211w

		uci set wireless.wifi2_ap.ssid="${SSID}_6GHz"
		uci set wireless.wifi2_ap.encryption='sae'
		uci set wireless.wifi2_ap.sae='1'
		uci set wireless.wifi2_ap.ieee80211w='2'

		if [ -n "$KEY" ]; then
			uci set wireless.wifi0_ap.key="$KEY"
			uci set wireless.wifi0_ap.sae_password="$KEY"
			uci set wireless.wifi1_ap.key="$KEY"
			uci set wireless.wifi1_ap.sae_password="$KEY"
			uci set wireless.wifi2_ap.key="$KEY"
			uci set wireless.wifi2_ap.sae_password="$KEY"
		fi

		uci set tripleband.tripleband.tripleband_basic='0'
		uci set tripleband.tripleband.mlo_enable='0'
		uci commit tripleband
	fi

	for v in wifi0_ap wifi1_ap wifi2_ap; do
		uci set wireless.$v.wds='1'
		uci set wireless.$v.rrm='1'
		uci set wireless.$v.bss_transition='1'
		uci set wireless.$v.rrm_neighbor_report='1'
		uci set wireless.$v.rrm_beacon_report='1'
		uci set wireless.$v.wnm_sleep_mode='1'
	done
	uci set wireless.wifi2_ap.en_6g_sec_comp='0'
	uci set wireless.wifi2_ap.ieee80211ai='1'
	uci set wireless.wifi2_ap.fils_fd_period='20'

	uci commit wireless
	[ -x /usr/sbin/predator-wifi-guard ] && /usr/sbin/predator-wifi-guard fix
	killall -9 lock 2>/dev/null
	rm -f /var/run/*lock* 2>/dev/null
	(
		sleep 1
		wifi reload
		sleep 3
		if [ "$MODE" = "mlo_turbo" ] || [ "$MODE" = "mlo_full" ]; then
			[ -d /sys/class/net/mld0 ] && { brctl addif br-lan mld0 2>/dev/null; ifconfig mld0 up 2>/dev/null; }
		else
			brctl delif br-lan mld0 2>/dev/null || true
		fi
		[ -x /lib/wifi_hardware_tune.sh ] && /lib/wifi_hardware_tune.sh
		/etc/init.d/predator_rf start 2>/dev/null
		[ -x /usr/sbin/predator-wifi-guard ] && ( /usr/sbin/predator-wifi-guard verify >/dev/null 2>&1 ) &
	) &
	echo '{ "success": true }'
}

do_set_radio() {
	read input
	DEV=$(echo "$input" | jsonfilter -e '@.device')
	CHAN=$(echo "$input" | jsonfilter -e '@.channel')
	HT=$(echo "$input" | jsonfilter -e '@.htmode')
	TX=$(echo "$input" | jsonfilter -e '@.txpower')

	[ -n "$DEV" ] || exit 1
	local FORCE_40="0"
	if [ "$DEV" = "wifi0" ]; then
		if [ "$HT" = "HT40_FORCE" ]; then
			HT="HT40"
			FORCE_40="1"
			uci set wireless.wifi0.chan_coex_disable='1'
			uci set wireless.wifi0_ap.disablecoext='1'
			if [ -z "$CHAN" ] || [ "$CHAN" = "auto" ]; then
				local cur_c0=$(uci -q get wireless.wifi0.channel)
				[ -z "$cur_c0" ] || [ "$cur_c0" = "auto" ] && CHAN="6"
			fi
		else
			uci set wireless.wifi0.chan_coex_disable='0'
			uci set wireless.wifi0_ap.disablecoext='0'
		fi
	fi
	[ -n "$CHAN" ] && uci set wireless.$DEV.channel="$CHAN"
	[ -n "$HT" ] && uci set wireless.$DEV.htmode="$HT"
	[ -n "$TX" ] && uci set wireless.$DEV.txpower="$TX"
	if [ "$DEV" = "wifi1" ]; then
		if [ "$HT" = "HT240" ]; then
			uci set wireless.wifi1.hwmode='11bea'
			uci set wireless.wifi1.blockdfslist='0'
			uci set wireless.wifi1.ccfs='130'
			uci set wireless.wifi1.puncture_bitmap='61440'
			uci set wireless.wifi1.puncture_strict='0'
			uci set wireless.wifi1.dfs_punctureEn='1'
			uci set wireless.wifi1_ap.cactimeout='1'
			if [ -z "$CHAN" ] || [ "$CHAN" = "auto" ] || [ "$CHAN" -lt 100 ] 2>/dev/null || [ "$CHAN" -gt 144 ] 2>/dev/null; then
				uci set wireless.wifi1.channel='100'
			fi
		elif [ "$HT" = "HT160" ]; then
			uci -q delete wireless.wifi1.ccfs
			uci -q delete wireless.wifi1.puncture_bitmap
			uci set wireless.wifi1.blockdfslist='0'
			if [ -n "$CHAN" ] && [ "$CHAN" != "auto" ]; then
				if [ "$CHAN" -gt 64 -a "$CHAN" -lt 100 ] 2>/dev/null || [ "$CHAN" -gt 128 ] 2>/dev/null; then
					uci set wireless.wifi1.channel='36'
				fi
			fi
		elif [ -n "$HT" ]; then
			uci -q delete wireless.wifi1.ccfs
			uci -q delete wireless.wifi1.puncture_bitmap
		fi
	fi
	if [ "$DEV" = "wifi2" ] && [ -n "$HT" ]; then
		if [ "$HT" = "HT240" ]; then
			uci set wireless.wifi2.hwmode='11bea'
			uci set wireless.wifi2.puncture_bitmap='61440'
		else
			uci -q delete wireless.wifi2.puncture_bitmap
		fi
	fi
	uci commit wireless
	killall -9 lock 2>/dev/null
	rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/load_qcawificfg80211_lock /var/run/pre_qcawificfg80211_lock /var/run/device_* 2>/dev/null
	(
		sleep 1
		killall hostapd 2>/dev/null
		killall -9 lock 2>/dev/null
		rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/load_qcawificfg80211_lock /var/run/pre_qcawificfg80211_lock /var/run/device_* 2>/dev/null
		/etc/init.d/qca-hostapd restart 2>/dev/null
		sleep 1
		/sbin/wifi up 2>/dev/null
		sleep 3
		case "$DEV" in
			wifi0) VAP="ath0" ;;
			wifi1) VAP="ath1" ;;
			wifi2) VAP="ath2" ;;
			*) VAP="" ;;
		esac
		if [ "$TX" = "auto" ] || [ -z "$TX" ]; then
			[ -n "$VAP" ] && iw dev "$VAP" set txpower auto 2>/dev/null || true
		elif [ -n "$VAP" ]; then
			iw dev "$VAP" set txpower fixed "$TX" 2>/dev/null || true
		fi
		[ -x /lib/wifi_hardware_tune.sh ] && /lib/wifi_hardware_tune.sh
		/etc/init.d/predator_rf start 2>/dev/null
		killall -9 lock 2>/dev/null
		rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/load_qcawificfg80211_lock /var/run/pre_qcawificfg80211_lock /var/run/device_* 2>/dev/null
	) &
	echo '{ "success": true }'
}

do_set_all_radios() {
	read input
	C0=$(echo "$input" | jsonfilter -e '@.wifi0.channel')
	H0=$(echo "$input" | jsonfilter -e '@.wifi0.htmode')
	P0=$(echo "$input" | jsonfilter -e '@.wifi0.txpower')

	C1=$(echo "$input" | jsonfilter -e '@.wifi1.channel')
	H1=$(echo "$input" | jsonfilter -e '@.wifi1.htmode')
	P1=$(echo "$input" | jsonfilter -e '@.wifi1.txpower')

	C2=$(echo "$input" | jsonfilter -e '@.wifi2.channel')
	H2=$(echo "$input" | jsonfilter -e '@.wifi2.htmode')
	P2=$(echo "$input" | jsonfilter -e '@.wifi2.txpower')

	# Radio 0 (2.4 GHz)
	if [ "$H0" = "HT40_FORCE" ]; then
		H0="HT40"
		uci set wireless.wifi0.chan_coex_disable='1'
		uci set wireless.wifi0_ap.disablecoext='1'
		if [ -z "$C0" ] || [ "$C0" = "auto" ]; then
			local cur_c0=$(uci -q get wireless.wifi0.channel)
			[ -z "$cur_c0" ] || [ "$cur_c0" = "auto" ] && C0="6"
		fi
	elif [ -n "$H0" ]; then
		uci set wireless.wifi0.chan_coex_disable='0'
		uci set wireless.wifi0_ap.disablecoext='0'
	fi
	[ -n "$C0" ] && uci set wireless.wifi0.channel="$C0"
	[ -n "$H0" ] && uci set wireless.wifi0.htmode="$H0"
	[ -n "$P0" ] && uci set wireless.wifi0.txpower="$P0"

	# Radio 1 (5 GHz)
	[ -n "$C1" ] && uci set wireless.wifi1.channel="$C1"
	[ -n "$H1" ] && uci set wireless.wifi1.htmode="$H1"
	[ -n "$P1" ] && uci set wireless.wifi1.txpower="$P1"
	if [ "$H1" = "HT240" ]; then
		uci set wireless.wifi1.hwmode='11bea'
		uci set wireless.wifi1.blockdfslist='0'
		uci set wireless.wifi1.ccfs='130'
		uci set wireless.wifi1.puncture_bitmap='61440'
			uci set wireless.wifi1.puncture_strict='0'
			uci set wireless.wifi1.dfs_punctureEn='1'
			uci set wireless.wifi1_ap.cactimeout='1'
		if [ -z "$C1" ] || [ "$C1" = "auto" ] || [ "$C1" -lt 100 ] 2>/dev/null || [ "$C1" -gt 144 ] 2>/dev/null; then
			uci set wireless.wifi1.channel='100'
		fi
	elif [ "$H1" = "HT160" ]; then
		uci -q delete wireless.wifi1.ccfs
		uci -q delete wireless.wifi1.puncture_bitmap
		uci set wireless.wifi1.blockdfslist='0'
		if [ -n "$C1" ] && [ "$C1" != "auto" ]; then
			if [ "$C1" -gt 64 -a "$C1" -lt 100 ] 2>/dev/null || [ "$C1" -gt 128 ] 2>/dev/null; then
				uci set wireless.wifi1.channel='36'
			fi
		fi
	elif [ -n "$H1" ]; then
		uci -q delete wireless.wifi1.ccfs
		uci -q delete wireless.wifi1.puncture_bitmap
	fi

	# Radio 2 (6 GHz Wi-Fi 7)
	[ -n "$C2" ] && uci set wireless.wifi2.channel="$C2"
	[ -n "$H2" ] && uci set wireless.wifi2.htmode="$H2"
	[ -n "$P2" ] && uci set wireless.wifi2.txpower="$P2"
	if [ "$H2" = "HT240" ]; then
		uci set wireless.wifi2.hwmode='11bea'
		uci set wireless.wifi2.puncture_bitmap='61440'
	elif [ -n "$H2" ]; then
		uci -q delete wireless.wifi2.puncture_bitmap
	fi

	uci commit wireless
	killall -9 lock 2>/dev/null
	rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/load_qcawificfg80211_lock /var/run/pre_qcawificfg80211_lock /var/run/device_* 2>/dev/null
	(
		sleep 1
		killall hostapd 2>/dev/null
		killall -9 lock 2>/dev/null
		rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/load_qcawificfg80211_lock /var/run/pre_qcawificfg80211_lock /var/run/device_* 2>/dev/null
		/etc/init.d/qca-hostapd restart 2>/dev/null
		sleep 1
		/sbin/wifi up 2>/dev/null
		sleep 3
		[ "$P0" = "auto" ] || [ -z "$P0" ] && iw dev ath0 set txpower auto 2>/dev/null || iw dev ath0 set txpower fixed "$P0" 2>/dev/null || true
		[ "$P1" = "auto" ] || [ -z "$P1" ] && iw dev ath1 set txpower auto 2>/dev/null || iw dev ath1 set txpower fixed "$P1" 2>/dev/null || true
		[ "$P2" = "auto" ] || [ -z "$P2" ] && iw dev ath2 set txpower auto 2>/dev/null || iw dev ath2 set txpower fixed "$P2" 2>/dev/null || true
		[ -x /lib/wifi_hardware_tune.sh ] && /lib/wifi_hardware_tune.sh
		/etc/init.d/predator_rf start 2>/dev/null
		killall -9 lock 2>/dev/null
		rm -f /var/run/wifilock /var/run/wifi_global_lock /var/run/load_qcawificfg80211_lock /var/run/pre_qcawificfg80211_lock /var/run/device_* 2>/dev/null
	) &
	echo '{ "success": true }'
}

do_edit_vif() {
	read input
	SEC=$(echo "$input" | jsonfilter -e '@.section')
	SSID=$(echo "$input" | jsonfilter -e '@.ssid')
	KEY=$(echo "$input" | jsonfilter -e '@.key')
	ENC=$(echo "$input" | jsonfilter -e '@.encryption')
	[ -z "$SEC" ] && { echo '{"success":false,"error":"section_empty"}'; exit 0; }
	[ -z "$SSID" ] && { echo '{"success":false,"error":"ssid_empty"}'; exit 0; }
	[ ${#SSID} -gt 32 ] && { echo '{"success":false,"error":"ssid_too_long"}'; exit 0; }

	local dev_v=$(uci -q get wireless.$SEC.device)
	if [ "$dev_v" = "wifi2" ]; then
		[ "$ENC" = "psk2" ] || [ "$ENC" = "psk2+aes" ] || [ "$ENC" = "sae-mixed" ] && ENC="sae"
		[ "$ENC" = "none" ] && ENC="owe"
	fi

	# Se a senha veio vazia na edicao, puxa a senha existente (requisito do usuario)
	if [ -z "$KEY" ]; then
		KEY=$(uci -q get wireless.$SEC.key || uci -q get wireless.$SEC.sae_password)
	fi

	# Se for rede protegida e mesmo assim nao tem senha, nao aplica
	if [ "$ENC" != "none" ] && [ "$ENC" != "owe" ]; then
		if [ -z "$KEY" ]; then
			echo '{"success":false,"error":"key_required"}'
			exit 0
		fi
		if [ ${#KEY} -lt 8 ] || [ ${#KEY} -gt 63 ]; then
			echo '{"success":false,"error":"key_invalid"}'
			exit 0
		fi
	fi

	[ -n "$SSID" ] && uci set wireless.$SEC.ssid="$SSID"
	[ -n "$ENC" ] && uci set wireless.$SEC.encryption="$ENC"
	
	if [ "$ENC" = "sae" ]; then
		uci set wireless.$SEC.sae='1'
		uci set wireless.$SEC.owe='0'
		uci set wireless.$SEC.ieee80211w='2'
	elif [ "$ENC" = "sae-mixed" ]; then
		uci set wireless.$SEC.sae='1'
		uci set wireless.$SEC.owe='0'
		uci set wireless.$SEC.ieee80211w='1'
	elif [ "$ENC" = "owe" ]; then
		uci set wireless.$SEC.owe='1'
		uci set wireless.$SEC.sae='0'
		uci set wireless.$SEC.ieee80211w='2'
		uci -q delete wireless.$SEC.key
		uci -q delete wireless.$SEC.sae_password
	elif [ "$ENC" = "none" ]; then
		uci set wireless.$SEC.owe='0'
		uci set wireless.$SEC.sae='0'
		uci set wireless.$SEC.ieee80211w='0'
		uci -q delete wireless.$SEC.key
		uci -q delete wireless.$SEC.sae_password
	elif [ "$ENC" = "psk2" ] || [ "$ENC" = "psk2+aes" ]; then
		uci set wireless.$SEC.encryption='psk2+aes'
		uci set wireless.$SEC.owe='0'
		uci set wireless.$SEC.sae='0'
		uci set wireless.$SEC.ieee80211w='0'
	fi

	if [ "$ENC" != "none" ] && [ "$ENC" != "owe" ] && [ -n "$KEY" ]; then
		uci set wireless.$SEC.key="$KEY"
		uci set wireless.$SEC.sae_password="$KEY"
	fi

	uci set wireless.$SEC.wds='1'
	uci set wireless.$SEC.rrm='1'
	uci set wireless.$SEC.bss_transition='1'
	uci set wireless.$SEC.rrm_neighbor_report='1'
	uci set wireless.$SEC.rrm_beacon_report='1'
	uci set wireless.$SEC.wnm_sleep_mode='1'
	if [ "$dev_v" = "wifi2" ]; then
		uci set wireless.$SEC.en_6g_sec_comp='0'
		uci set wireless.$SEC.ieee80211ai='1'
		uci set wireless.$SEC.fils_fd_period='20'
	fi

	uci commit wireless
	[ -x /usr/sbin/predator-wifi-guard ] && /usr/sbin/predator-wifi-guard fix
	rm -f /var/run/*lock* 2>/dev/null; ( sleep 1; wifi reload; [ -x /usr/sbin/predator-wifi-guard ] && ( /usr/sbin/predator-wifi-guard verify >/dev/null 2>&1 ) & ) &
	echo '{ "success": true }'
}

do_add_vif() {
	read input
	SSID=$(echo "$input" | jsonfilter -e '@.ssid')
	KEY=$(echo "$input" | jsonfilter -e '@.key')
	ENC=$(echo "$input" | jsonfilter -e '@.encryption')
	B2G=$(echo "$input" | jsonfilter -e '@.band_2g')
	B5G=$(echo "$input" | jsonfilter -e '@.band_5g')
	B6G=$(echo "$input" | jsonfilter -e '@.band_6g')
	GUEST=$(echo "$input" | jsonfilter -e '@.is_guest')
	IS_MLD=$(echo "$input" | jsonfilter -e '@.is_mld')

	[ -z "$SSID" ] && { echo '{"success":false,"error":"ssid_empty"}'; exit 0; }
	[ ${#SSID} -gt 32 ] && { echo '{"success":false,"error":"ssid_too_long"}'; exit 0; }
	[ -z "$ENC" ] && ENC="sae-mixed"

	if [ "$ENC" != "none" ] && [ "$ENC" != "owe" ]; then
		if [ -z "$KEY" ]; then
			echo '{"success":false,"error":"key_required"}'
			exit 0
		fi
		if [ ${#KEY} -lt 8 ] || [ ${#KEY} -gt 63 ]; then
			echo '{"success":false,"error":"key_invalid"}'
			exit 0
		fi
	fi

	net_zone="lan"
	isolate_val="0"
	if [ "$GUEST" = "true" ] || [ "$GUEST" = "1" ]; then
		net_zone="guest"
		isolate_val="1"
	fi

	# VAPs adicionais (redes secundarias) operam com maxima estabilidade
	# em modo multi-banda padrao, pois o silicio Qualcomm IPQ5332 nao suporta
	# MBSSID concorrente com MLO nas bandas baixas (mlo_mbssid disabled).
	ts=$(date +%s)
	if [ "$B2G" = "true" ] || [ "$B2G" = "1" ]; then
		sid="vif_2g_${ts}"
		uci set wireless.$sid=wifi-iface
		uci set wireless.$sid.device='wifi0'
		uci set wireless.$sid.network="$net_zone"
		uci set wireless.$sid.mode='ap'
		uci set wireless.$sid.ssid="$SSID"
		uci set wireless.$sid.isolate="$isolate_val"
		uci set wireless.$sid.encryption="$ENC"
		if [ "$ENC" = "owe" ]; then
			uci set wireless.$sid.owe='1'
			uci set wireless.$sid.ieee80211w='2'
		elif [ "$ENC" != "none" ] && [ -n "$KEY" ]; then
			uci set wireless.$sid.key="$KEY"
			uci set wireless.$sid.sae_password="$KEY"
			[ "$ENC" = "sae" ] && uci set wireless.$sid.sae='1' && uci set wireless.$sid.ieee80211w='2'
			[ "$ENC" = "sae-mixed" ] && uci set wireless.$sid.sae='1' && uci set wireless.$sid.ieee80211w='1'
		fi
		uci set wireless.$sid.wds='1'
		uci set wireless.$sid.rrm='1'
		uci set wireless.$sid.bss_transition='1'
		uci set wireless.$sid.rrm_neighbor_report='1'
		uci set wireless.$sid.rrm_beacon_report='1'
		uci set wireless.$sid.wnm_sleep_mode='1'
	fi

	if [ "$B5G" = "true" ] || [ "$B5G" = "1" ]; then
		sid="vif_5g_${ts}"
		uci set wireless.$sid=wifi-iface
		uci set wireless.$sid.device='wifi1'
		uci set wireless.$sid.network="$net_zone"
		uci set wireless.$sid.mode='ap'
		uci set wireless.$sid.ssid="$SSID"
		uci set wireless.$sid.isolate="$isolate_val"
		uci set wireless.$sid.encryption="$ENC"
		if [ "$ENC" = "owe" ]; then
			uci set wireless.$sid.owe='1'
			uci set wireless.$sid.ieee80211w='2'
		elif [ "$ENC" != "none" ] && [ -n "$KEY" ]; then
			uci set wireless.$sid.key="$KEY"
			uci set wireless.$sid.sae_password="$KEY"
			[ "$ENC" = "sae" ] && uci set wireless.$sid.sae='1' && uci set wireless.$sid.ieee80211w='2'
			[ "$ENC" = "sae-mixed" ] && uci set wireless.$sid.sae='1' && uci set wireless.$sid.ieee80211w='1'
		fi
		uci set wireless.$sid.wds='1'
		uci set wireless.$sid.rrm='1'
		uci set wireless.$sid.bss_transition='1'
		uci set wireless.$sid.rrm_neighbor_report='1'
		uci set wireless.$sid.rrm_beacon_report='1'
		uci set wireless.$sid.wnm_sleep_mode='1'
	fi

	if [ "$B6G" = "true" ] || [ "$B6G" = "1" ]; then
		sid="vif_6g_${ts}"
		uci set wireless.$sid=wifi-iface
		uci set wireless.$sid.device='wifi2'
		uci set wireless.$sid.network="$net_zone"
		uci set wireless.$sid.mode='ap'
		uci set wireless.$sid.ssid="$SSID"
		local enc6="$ENC"
		[ "$enc6" = "psk2" ] || [ "$enc6" = "psk2+aes" ] || [ "$enc6" = "sae-mixed" ] && enc6="sae"
		[ "$enc6" = "none" ] && enc6="owe"
		uci set wireless.$sid.encryption="$enc6"
		if [ "$enc6" = "owe" ]; then
			uci set wireless.$sid.owe='1'
			uci set wireless.$sid.ieee80211w='2'
		else
			uci set wireless.$sid.sae='1'
			uci set wireless.$sid.ieee80211w='2'
			if [ -n "$KEY" ]; then
				uci set wireless.$sid.key="$KEY"
				uci set wireless.$sid.sae_password="$KEY"
			fi
		fi
		uci set wireless.$sid.isolate="$isolate_val"
		uci set wireless.$sid.wds='1'
		uci set wireless.$sid.rrm='1'
		uci set wireless.$sid.bss_transition='1'
		uci set wireless.$sid.rrm_neighbor_report='1'
		uci set wireless.$sid.rrm_beacon_report='1'
		uci set wireless.$sid.wnm_sleep_mode='1'
		uci set wireless.$sid.en_6g_sec_comp='0'
		uci set wireless.$sid.ieee80211ai='1'
		uci set wireless.$sid.fils_fd_period='20'
	fi

	uci commit wireless
	[ -x /usr/sbin/predator-wifi-guard ] && /usr/sbin/predator-wifi-guard fix
	killall -9 lock 2>/dev/null
	rm -f /var/run/*lock* 2>/dev/null; ( sleep 1; wifi reload; [ -x /usr/sbin/predator-wifi-guard ] && ( /usr/sbin/predator-wifi-guard verify >/dev/null 2>&1 ) & ) &
	echo '{ "success": true }'
}

do_del_vif() {
	read input
	SEC=$(echo "$input" | jsonfilter -e '@.section')
	[ -z "$SEC" ] && exit 1
	if [ "$SEC" != "wifi0_ap" ] && [ "$SEC" != "wifi1_ap" ] && [ "$SEC" != "wifi2_ap" ]; then
		local del_ssid=$(uci -q get wireless.$SEC.ssid)
		if [ -n "$del_ssid" ]; then
			for s in $(uci show wireless | grep "\.ssid='$del_ssid'" | cut -d'.' -f2 | cut -d'=' -f1); do
				if [ "$s" != "wifi0_ap" ] && [ "$s" != "wifi1_ap" ] && [ "$s" != "wifi2_ap" ]; then
					uci -q delete wireless.$s
				fi
			done
		else
			uci -q delete wireless.$SEC
		fi
		uci commit wireless
		killall -9 lock 2>/dev/null
		rm -f /var/run/*lock* 2>/dev/null; ( sleep 1; wifi reload ) &
	fi
	echo '{ "success": true }'
}

