do_toggle_feature() {
	read input
	FEAT=$(echo "$input" | jsonfilter -e '@.feature')
	VAL=$(echo "$input" | jsonfilter -e '@.value')
	[ -z "$FEAT" ] && exit 1
	[ -z "$VAL" ] && VAL="1"

	case "$FEAT" in
		gaming)
			cfg80211tool wifi0 low_latency_mode "$VAL" 2>/dev/null || true
			cfg80211tool wifi1 low_latency_mode "$VAL" 2>/dev/null || true
			cfg80211tool wifi2 low_latency_mode "$VAL" 2>/dev/null || true
			for a in ath0 ath1 ath11 ath2; do
				if [ -d "/sys/class/net/$a" ]; then
					cfg80211tool "$a" noackpolicy 0 0 2>/dev/null || true
					cfg80211tool "$a" noackpolicy 6 0 2>/dev/null || true
				fi
			done
			uci set tripleband.tripleband.gaming_mode="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		mscs_scs)
			insmod qca-nss-mscs 2>/dev/null || true
			insmod ecm-wifi-plugin 2>/dev/null || true
			for a in ath0 ath1 ath11 ath2; do
				if [ -d "/sys/class/net/$a" ]; then
					cfg80211tool "$a" hlos_tidoverride "$VAL" 2>/dev/null || true
					cfg80211tool "$a" mscs "$VAL" 2>/dev/null || true
					cfg80211tool "$a" scs "$VAL" 2>/dev/null || true
					cfg80211tool "$a" noackpolicy 0 0 2>/dev/null || true
					cfg80211tool "$a" noackpolicy 6 0 2>/dev/null || true
				fi
			done
			echo "$VAL" > /sys/kernel/debug/ecm/ecm_classifier_mscs/enabled 2>/dev/null || true
			echo "$VAL" > /sys/kernel/debug/ecm/ecm_classifier_mscs/scs_enabled 2>/dev/null || true
			echo 5200 > /sys/kernel/debug/ecm/ecm_classifier_mscs/udp_ipsec_port 2>/dev/null || true
			echo 1 > /sys/kernel/debug/ecm/ecm_classifier_emesh/enabled 2>/dev/null || true
			echo "$VAL" > /sys/kernel/debug/ecm/ecm_classifier_emesh/latency_config_enabled 2>/dev/null || true
			echo 1 > /sys/kernel/debug/ecm/ecm_classifier_emesh/cake_enabled 2>/dev/null || true
			echo 5200 > /sys/kernel/debug/ecm/ecm_classifier_emesh/udp_ipsec_port 2>/dev/null || true
			echo 1 > /sys/kernel/debug/ecm/ecm_classifier_dscp/enabled 2>/dev/null || true
			if [ "$VAL" = "1" ]; then
				pgrep -x "scs_tool" >/dev/null 2>&1 || /usr/sbin/scs_tool >/dev/null 2>&1 &
			else
				killall scs_tool 2>/dev/null || true
			fi
			uci set tripleband.tripleband.mscs_scs="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		twt)
			for a in ath0 ath1 ath2; do
				[ -d "/sys/class/net/$a" ] && cfg80211tool "$a" twt_responder "$VAL" 2>/dev/null || true
			done
			for sec in wifi0_ap wifi1_ap wifi2_ap; do
				[ -n "$(uci -q get wireless.$sec)" ] && uci set wireless.$sec.twt_responder="$VAL" 2>/dev/null || true
			done
			uci commit wireless 2>/dev/null || true
			uci set tripleband.tripleband.twt_enable="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		cca_mitigation)
			wifitool ath0 setUnitTestCmd 67 3 16 0 "$VAL" 2>/dev/null || true
			wifitool ath1 setUnitTestCmd 67 3 16 1 "$VAL" 2>/dev/null || true
			uci set tripleband.tripleband.cca_mitigation="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		compat_iot)
			uci set tripleband.tripleband.compat_iot="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			( sleep 1; wifi reload; sleep 2; /etc/init.d/predator_rf start 2>/dev/null ) &
			;;
		sqm_cake)
			uci set sqm.wan.enabled="$VAL" 2>/dev/null || true
			uci commit sqm 2>/dev/null || true
			if [ "$VAL" = "1" ]; then
				ethtool -K eth0 gso on 2>/dev/null || true
				echo 1 > /sys/kernel/debug/ecm/front_end_ipv4_stop 2>/dev/null || true
				echo 1 > /sys/kernel/debug/ecm/front_end_ipv6_stop 2>/dev/null || true
				echo 1 > /sys/kernel/debug/ecm/ecm_db/defunct_all 2>/dev/null || true
				/etc/init.d/sqm start 2>/dev/null || /usr/lib/sqm/run.sh start eth0 2>/dev/null || true
			else
				/etc/init.d/sqm stop 2>/dev/null || /usr/lib/sqm/run.sh stop eth0 2>/dev/null || true
				echo 0 > /sys/kernel/debug/ecm/front_end_ipv4_stop 2>/dev/null || true
				echo 0 > /sys/kernel/debug/ecm/front_end_ipv6_stop 2>/dev/null || true
			fi
			;;
		wisp_sta)
			if [ -n "$(uci -q get wireless.wwan_sta)" ]; then
				if [ "$VAL" = "1" ]; then
					uci set wireless.wwan_sta.disabled='0'
					uci set network.wwan.auto='1' 2>/dev/null || true
				else
					uci set wireless.wwan_sta.disabled='1'
					uci set network.wwan.auto='0' 2>/dev/null || true
					ifdown wwan 2>/dev/null || true
				fi
				uci commit wireless 2>/dev/null || true
				uci commit network 2>/dev/null || true
				( sleep 1; wifi reload; sleep 2; /etc/init.d/predator_rf start 2>/dev/null ) &
			fi
			;;
		ani)
			cfg80211tool wifi0 ani_enable "$VAL" 2>/dev/null || true
			cfg80211tool wifi1 ani_enable "$VAL" 2>/dev/null || true
			cfg80211tool wifi2 ani_enable "$VAL" 2>/dev/null || true
			uci set tripleband.tripleband.ani_enable="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		rnr_6g)
			if [ "$VAL" = "1" ]; then
				cfg80211tool wifi0 rnr_6ghz_colocated 1 7 2>/dev/null || true
				cfg80211tool wifi1 rnr_6ghz_colocated 1 7 2>/dev/null || true
				cfg80211tool wifi2 rnr_member_ess_colocated_en 1 2>/dev/null || true
				cfg80211tool ath2 enable_fils 1 20 2>/dev/null || true
			else
				cfg80211tool wifi0 rnr_6ghz_colocated 0 7 2>/dev/null || true
				cfg80211tool wifi1 rnr_6ghz_colocated 0 7 2>/dev/null || true
				cfg80211tool wifi2 rnr_member_ess_colocated_en 0 2>/dev/null || true
				cfg80211tool ath2 enable_fils 0 20 2>/dev/null || true
			fi
			uci set tripleband.tripleband.rnr_colocated="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		qam4096)
			# Toggle Wi-Fi 7 (4096-QAM / 11bea + HT320) vs Wi-Fi 6E (1024-QAM / 11axa + HT160)
			if [ "$VAL" = "1" ]; then
				uci set wireless.wifi2.hwmode='11bea'
				[ "$(uci -q get wireless.wifi2.htmode)" = "HT160" ] && uci set wireless.wifi2.htmode='HT320'
			else
				uci set wireless.wifi2.hwmode='11axa'
				[ "$(uci -q get wireless.wifi2.htmode)" = "HT320" ] && uci set wireless.wifi2.htmode='HT160'
			fi
			uci commit wireless
			( sleep 1; wifi reload; sleep 2; [ -d /sys/class/net/mld0 ] && { brctl addif br-lan mld0 2>/dev/null; ifconfig mld0 up 2>/dev/null; } ) &
			;;
		rps)
			if [ "$VAL" = "1" ]; then
				mask="f"
			else
				mask="1"
			fi
			for q in /sys/class/net/*/queues/rx-*/rps_cpus; do
				[ -f "$q" ] && echo "$mask" > "$q" 2>/dev/null || true
			done
			uci set tripleband.tripleband.rps_quadcore="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		puncturing)
			cfg80211tool wifi1 dfs_puncture_en "$VAL" 2>/dev/null || true
			cfg80211tool wifi1 puncture_strict 0 2>/dev/null || true
			cfg80211tool wifi2 puncture_strict 0 2>/dev/null || true
			uci set tripleband.tripleband.puncturing="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
		beamforming)
			if [ "$VAL" = "1" ]; then
				snd=100
			else
				snd=0
			fi
			cfg80211tool wifi0 txbf_snd_int "$snd" 2>/dev/null || true
			cfg80211tool wifi1 txbf_snd_int "$snd" 2>/dev/null || true
			cfg80211tool wifi2 txbf_snd_int "$snd" 2>/dev/null || true
			for a in ath0 ath1 ath2; do
				if [ -d "/sys/class/net/$a" ]; then
					cfg80211tool "$a" he_subfer "$VAL" 2>/dev/null || true
					cfg80211tool "$a" he_subfee "$VAL" 2>/dev/null || true
					cfg80211tool "$a" he_mubfer "$VAL" 2>/dev/null || true
					cfg80211tool "$a" set_eht_su_bfmr "$VAL" 2>/dev/null || true
					cfg80211tool "$a" set_eht_su_bfme "$VAL" 2>/dev/null || true
					cfg80211tool "$a" set_eht_mu_bfmr "$VAL" 2>/dev/null || true
				fi
			done
			uci set tripleband.tripleband.beamforming="$VAL" 2>/dev/null || true
			uci commit tripleband 2>/dev/null || true
			;;
	esac
	echo "{ \"success\": true, \"feature\": \"$FEAT\", \"value\": \"$VAL\" }"
}

