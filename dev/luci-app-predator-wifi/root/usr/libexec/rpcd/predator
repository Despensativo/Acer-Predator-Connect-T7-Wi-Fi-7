#!/bin/sh

get_radios_json() {
	# Auto-clean orphan locks if process is dead (strictly wifi locks)
	for lk in /var/run/wifilock /var/run/wifi_global_lock /var/run/load_qcawificfg80211_lock /var/run/pre_qcawificfg80211_lock; do
		[ -f "$lk" ] || continue
		lpid=$(awk 'NR==1{print $1}' "$lk" 2>/dev/null | tr -cd '0-9')
		if [ -n "$lpid" ]; then
			[ ! -d "/proc/$lpid" ] && rm -f "$lk"
		else
			rm -f "$lk"
		fi
	done

	# Kill any orphaned /bin/lock processes whose parent is init (PPid=1)
	for p in $(pidof lock 2>/dev/null); do
		if [ "$(awk '/PPid:/{print $2}' /proc/$p/status 2>/dev/null)" = "1" ]; then
			kill -9 "$p" 2>/dev/null
		fi
	done

	local c0=$(uci -q get wireless.wifi0.channel || echo "auto")
	local h0=$(uci -q get wireless.wifi0.htmode || echo "HT40")
	local coex0=$(uci -q get wireless.wifi0_ap.disablecoext || uci -q get wireless.wifi0.chan_coex_disable || echo "0")
	[ "$h0" = "HT40" ] && [ "$coex0" = "1" ] && h0="HT40_FORCE"
	local p0=$(uci -q get wireless.wifi0.txpower || echo "22")
	local def_p0="22"
	[ "$p0" = "auto" ] || [ -z "$p0" ] && def_p0="22" || { [ "$p0" -gt 30 ] 2>/dev/null && p0="22" || def_p0="$p0"; }
	local d0=$(uci -q get wireless.wifi0.disabled || echo "0")
	local s0="online"
	[ "$d0" = "1" ] && s0="disabled" || { [ -S /var/run/hostapd-wifi0/ath0 ] || s0="offline"; }
	local st0=$(hostapd_cli -i ath0 -p /var/run/hostapd-wifi0 status 2>/dev/null)
	local real_ch0=$(echo "$st0" | awk -F'=' '/^channel=/{print $2}')
	local real_w0="20"
	if echo "$st0" | grep -qE '^secondary_channel=[1-]'; then
		real_w0="40"
	elif [ "$coex0" = "1" ] && iw dev ath0 info 2>/dev/null | grep -q "width: 40 MHz"; then
		real_w0="40"
	fi
	local real_p0=$(iw dev ath0 info 2>/dev/null | grep txpower | awk '{print $2}')
	[ -z "$real_p0" ] || [ "$real_p0" = "0.00" ] || [ "$(echo $real_p0 | cut -d. -f1)" -gt 30 ] 2>/dev/null && real_p0="${def_p0}.00"
	local t0=$(thermaltool -i wifi0 -get -g 2>/dev/null | grep 'sensor temperature' | awk '{print $3}' | tr -d ',' || echo 0)
	[ -n "$t0" ] && [ "$t0" -gt 0 ] 2>/dev/null && [ "$t0" -lt 125 ] 2>/dev/null || t0=0

	local c1=$(uci -q get wireless.wifi1.channel || echo "auto")
	local h1=$(uci -q get wireless.wifi1.htmode || echo "HT160")
	local p1=$(uci -q get wireless.wifi1.txpower || echo "23")
	local st1=$(hostapd_cli -i ath1 -p /var/run/hostapd-wifi1 status 2>/dev/null)
	local real_ch1=$(echo "$st1" | awk -F'=' '/^channel=/{print $2}')
	local cur_ch1="${real_ch1:-$c1}"
	local is_unii3=0
	[ -n "$cur_ch1" ] && [ "$cur_ch1" -ge 100 ] 2>/dev/null && is_unii3=1
	local def_p1="26"
	if [ "$p1" = "auto" ] || [ -z "$p1" ]; then
		[ "$is_unii3" = "1" ] && def_p1="26" || { [ "$h1" = "HT160" ] && def_p1="23" || def_p1="26"; }
	else
		[ "$p1" -gt 30 ] 2>/dev/null && p1="26"
		def_p1="$p1"
		[ "$is_unii3" = "0" ] && [ "$h1" = "HT160" ] && [ "$def_p1" -gt 23 ] 2>/dev/null && def_p1="23"
	fi
	local d1=$(uci -q get wireless.wifi1.disabled || echo "0")
	local s1="online"
	[ "$d1" = "1" ] && s1="disabled" || { [ -S /var/run/hostapd-wifi1/ath1 ] || s1="offline"; }
	local real_w1="20"
	if [ "$h1" = "HT240" ] || [ "$(uci -q get wireless.wifi1.puncture_bitmap)" = "61440" ]; then
		real_w1="240"
	elif echo "$st1" | grep -qE '^eht_oper_chwidth=4'; then
		real_w1="240"
	elif echo "$st1" | grep -qE '^(eht|he|vht)_oper_chwidth=2'; then
		real_w1="160"
	elif echo "$st1" | grep -qE '^(eht|he|vht)_oper_chwidth=1'; then
		real_w1="80"
	elif echo "$st1" | grep -qE '^secondary_channel=[1-]'; then
		real_w1="40"
	elif iw dev ath1 info 2>/dev/null | grep -q "width: 40 MHz"; then
		real_w1="40"
	elif iw dev ath1 info 2>/dev/null | grep -q "width: 80 MHz"; then
		real_w1="80"
	elif iw dev ath1 info 2>/dev/null | grep -q "width: 160 MHz"; then
		real_w1="160"
	elif iw dev ath1 info 2>/dev/null | grep -q "width: 320 MHz"; then
		real_w1="240"
	fi
	local real_p1=$(iw dev ath1 info 2>/dev/null | grep txpower | awk '{print $2}')
	[ -z "$real_p1" ] || [ "$real_p1" = "0.00" ] || [ "$(echo $real_p1 | cut -d. -f1)" -gt 30 ] 2>/dev/null && real_p1="${def_p1}.00"
	local t1=$(thermaltool -i wifi1 -get -g 2>/dev/null | grep 'sensor temperature' | awk '{print $3}' | tr -d ',' || echo 0)
	[ -n "$t1" ] && [ "$t1" -gt 0 ] 2>/dev/null && [ "$t1" -lt 125 ] 2>/dev/null || t1=0

	local c2=$(uci -q get wireless.wifi2.channel || echo "37")
	local h2=$(uci -q get wireless.wifi2.htmode || echo "HT320")
	local p2=$(uci -q get wireless.wifi2.txpower || echo "20")
	local def_p2="20"
	[ "$p2" = "auto" ] || [ -z "$p2" ] && def_p2="20" || { [ "$p2" -gt 30 ] 2>/dev/null && p2="20" || def_p2="$p2"; }
	local d2=$(uci -q get wireless.wifi2.disabled || echo "0")
	local s2="online"
	[ "$d2" = "1" ] && s2="disabled" || { [ -S /var/run/hostapd-wifi2/ath2 ] || s2="offline"; }
	local st2=$(hostapd_cli -i ath2 -p /var/run/hostapd-wifi2 status 2>/dev/null)
	local real_ch2=$(echo "$st2" | awk -F'=' '/^channel=/{print $2}')
	local real_w2="320"
	[ "$h2" = "HT240" ] && real_w2="240"
	[ "$h2" = "HT160" ] && real_w2="160"
	[ "$h2" = "HT80" ] && real_w2="80"
	local real_p2=$(iw dev ath2 info 2>/dev/null | grep txpower | awk '{print $2}')
	[ -z "$real_p2" ] || [ "$real_p2" = "0.00" ] || [ "$(echo $real_p2 | cut -d. -f1)" -gt 30 ] 2>/dev/null && real_p2="${def_p2}.00"
	local t2=$(thermaltool -i wifi2 -get -g 2>/dev/null | grep 'sensor temperature' | awk '{print $3}' | tr -d ',' || echo 0)
	[ -n "$t2" ] && [ "$t2" -gt 0 ] 2>/dev/null && [ "$t2" -lt 125 ] 2>/dev/null || t2=0

	local bdf_name=$(ls -l /lib/firmware/qcn9224/bdwlan.b1015 2>/dev/null | awk -F'/' '{print $NF}')

	# Hardware Noise Floor (dBm) & CCA Airtime Breakdown (%)
	local nf0=$(cfg80211tool ath0 get_channf 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9-')
	[ -z "$nf0" ] || [ "$nf0" -ge 0 ] 2>/dev/null && nf0="-95"
	local cu0=$(cfg80211tool wifi0 g_chanutil 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local tx0=$(cfg80211tool wifi0 g_ch_util_ap_tx 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local rx0=$(cfg80211tool wifi0 g_ch_util_ap_rx 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local ob0=$(cfg80211tool wifi0 g_ch_util_obss 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local nw0=$(cfg80211tool wifi0 g_ch_util_nwifi 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local fr0=$(cfg80211tool wifi0 g_ch_util_free 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	[ "${cu0:-0}" -gt 100 ] 2>/dev/null && cu0=0; [ "${tx0:-0}" -gt 100 ] 2>/dev/null && tx0=0; [ "${rx0:-0}" -gt 100 ] 2>/dev/null && rx0=0; [ "${ob0:-0}" -gt 100 ] 2>/dev/null && ob0=0; [ "${nw0:-0}" -gt 100 ] 2>/dev/null && nw0=0
	[ "${fr0:-100}" -gt 100 ] 2>/dev/null && fr0=$((100 - ${tx0:-0} - ${rx0:-0} - ${ob0:-0} - ${nw0:-0}))
	[ "${fr0:-0}" -lt 0 ] 2>/dev/null && fr0=0

	local nf1=$(cfg80211tool ath1 get_channf 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9-')
	[ -z "$nf1" ] || [ "$nf1" -ge 0 ] 2>/dev/null && nf1="-102"
	local cu1=$(cfg80211tool wifi1 g_chanutil 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local tx1=$(cfg80211tool wifi1 g_ch_util_ap_tx 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local rx1=$(cfg80211tool wifi1 g_ch_util_ap_rx 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local ob1=$(cfg80211tool wifi1 g_ch_util_obss 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local nw1=$(cfg80211tool wifi1 g_ch_util_nwifi 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local fr1=$(cfg80211tool wifi1 g_ch_util_free 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	[ "${cu1:-0}" -gt 100 ] 2>/dev/null && cu1=0; [ "${tx1:-0}" -gt 100 ] 2>/dev/null && tx1=0; [ "${rx1:-0}" -gt 100 ] 2>/dev/null && rx1=0; [ "${ob1:-0}" -gt 100 ] 2>/dev/null && ob1=0; [ "${nw1:-0}" -gt 100 ] 2>/dev/null && nw1=0
	[ "${fr1:-100}" -gt 100 ] 2>/dev/null && fr1=$((100 - ${tx1:-0} - ${rx1:-0} - ${ob1:-0} - ${nw1:-0}))
	[ "${fr1:-0}" -lt 0 ] 2>/dev/null && fr1=0

	local nf2=$(cfg80211tool ath2 get_channf 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9-')
	[ -z "$nf2" ] || [ "$nf2" -ge 0 ] 2>/dev/null && nf2="-99"
	local cu2=$(cfg80211tool wifi2 g_chanutil 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local tx2=$(cfg80211tool wifi2 g_ch_util_ap_tx 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local rx2=$(cfg80211tool wifi2 g_ch_util_ap_rx 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local ob2=$(cfg80211tool wifi2 g_ch_util_obss 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local nw2=$(cfg80211tool wifi2 g_ch_util_nwifi 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	local fr2=$(cfg80211tool wifi2 g_ch_util_free 2>/dev/null | awk -F':' '{print $2}' | tr -cd '0-9')
	[ "${cu2:-0}" -gt 100 ] 2>/dev/null && cu2=0; [ "${tx2:-0}" -gt 100 ] 2>/dev/null && tx2=0; [ "${rx2:-0}" -gt 100 ] 2>/dev/null && rx2=0; [ "${ob2:-0}" -gt 100 ] 2>/dev/null && ob2=0; [ "${nw2:-0}" -gt 100 ] 2>/dev/null && nw2=0
	[ "${fr2:-100}" -gt 100 ] 2>/dev/null && fr2=$((100 - ${tx2:-0} - ${rx2:-0} - ${ob2:-0} - ${nw2:-0}))
	[ "${fr2:-0}" -lt 0 ] 2>/dev/null && fr2=0

	local lock_status="clean"
	for lk in /var/run/wifilock /var/run/wifi_global_lock /var/run/load_qcawificfg80211_lock /var/run/pre_qcawificfg80211_lock /var/run/luci-reload; do
		[ -f "$lk" ] || continue
		lpid=$(awk 'NR==1{print $1}' "$lk" 2>/dev/null | tr -cd '0-9')
		if [ -n "$lpid" ] && [ -d "/proc/$lpid" ]; then
			lock_status="locked"
			break
		fi
	done

	printf '{"wifi0":{"channel":"%s","htmode":"%s","txpower":"%s","disabled":"%s","status":"%s","real_channel":"%s","real_width":"%s","real_txpower":"%s","temp":"%s","nf":"%s","chutil":"%s","util_tx":"%s","util_rx":"%s","util_obss":"%s","util_nwifi":"%s","util_free":"%s"},' \
		"$c0" "$h0" "$p0" "$d0" "$s0" "${real_ch0:-$c0}" "${real_w0:-40}" "$real_p0" "$t0" "$nf0" "${cu0:-0}" "${tx0:-0}" "${rx0:-0}" "${ob0:-0}" "${nw0:-0}" "${fr0:-100}"
	printf '"wifi1":{"channel":"%s","htmode":"%s","txpower":"%s","disabled":"%s","status":"%s","real_channel":"%s","real_width":"%s","real_txpower":"%s","temp":"%s","nf":"%s","chutil":"%s","util_tx":"%s","util_rx":"%s","util_obss":"%s","util_nwifi":"%s","util_free":"%s"},' \
		"$c1" "$h1" "$p1" "$d1" "$s1" "${real_ch1:-$c1}" "${real_w1:-160}" "$real_p1" "$t1" "$nf1" "${cu1:-0}" "${tx1:-0}" "${rx1:-0}" "${ob1:-0}" "${nw1:-0}" "${fr1:-100}"
	printf '"wifi2":{"channel":"%s","htmode":"%s","txpower":"%s","disabled":"%s","status":"%s","real_channel":"%s","real_width":"%s","real_txpower":"%s","temp":"%s","bdf":"%s","nf":"%s","chutil":"%s","util_tx":"%s","util_rx":"%s","util_obss":"%s","util_nwifi":"%s","util_free":"%s"},' \
		"$c2" "$h2" "$p2" "$d2" "$s2" "${real_ch2:-$c2}" "${real_w2:-320}" "$real_p2" "$t2" "$bdf_name" "$nf2" "${cu2:-0}" "${tx2:-0}" "${rx2:-0}" "${ob2:-0}" "${nw2:-0}" "${fr2:-100}"
	printf '"lock_status":"%s"}' "$lock_status"
}

get_ifaces_json() {
	local first=1
	printf '['
	for iface in $(uci show wireless | grep '=wifi-iface' | cut -d'.' -f2 | cut -d'=' -f1); do
		local dev=$(uci -q get wireless.$iface.device)
		local ssid=$(uci -q get wireless.$iface.ssid)
		local enc=$(uci -q get wireless.$iface.encryption || echo "none")
		local dis=$(uci -q get wireless.$iface.disabled || echo "0")
		local net=$(uci -q get wireless.$iface.network || echo "lan")
		local mld=$(uci -q get wireless.$iface.mld || echo "")
		local key=$(uci -q get wireless.$iface.key)
		[ -z "$key" ] && key=$(uci -q get wireless.$iface.sae_password || echo "")
		
		[ $first -eq 0 ] && printf ','
		first=0
		printf '{"section":"%s","device":"%s","ssid":"%s","key":"%s","encryption":"%s","disabled":"%s","network":"%s","mld":"%s"}' \
			"$iface" "$dev" "$ssid" "$key" "$enc" "$dis" "$net" "$mld"
	done
	printf ']'
}

get_mode() {
	local mlo=$(uci -q get tripleband.tripleband.mlo_enable || echo "0")
	local m0=$(uci -q get wireless.wifi0_ap.mld || echo "")
	local m1=$(uci -q get wireless.wifi1_ap.mld || echo "")
	local s0=$(uci -q get wireless.wifi0_ap.ssid || echo "")
	local s1=$(uci -q get wireless.wifi1_ap.ssid || echo "")
	local s2=$(uci -q get wireless.wifi2_ap.ssid || echo "")

	if [ "$mlo" = "1" ] && [ "$m0" = "mld0" ]; then
		echo "mlo_full"
	elif [ "$mlo" = "1" ] && [ "$m1" = "mld0" ]; then
		echo "mlo_turbo"
	elif [ -n "$s0" ] && [ "$s0" = "$s1" ] && [ "$s0" = "$s2" ]; then
		echo "single_ssid"
	elif [ -n "$s0" ] && [ "$s0" = "$s1" ] && [ "$s0" != "$s2" ]; then
		echo "speed_max"
	else
		echo "separate"
	fi
}

get_ports_json() {
	local w_speed=$(cat /sys/class/net/eth0/speed 2>/dev/null || echo 0)
	local w_duplex=$(cat /sys/class/net/eth0/duplex 2>/dev/null || echo "unknown")
	local w_carrier=$(cat /sys/class/net/eth0/carrier 2>/dev/null || echo 0)

	local l0_speed=$(swconfig dev switch1 port 1 get link 2>/dev/null | grep -o "speed:[^ ]*" | cut -d":" -f2 || echo "")
	local l0_link=$(swconfig dev switch1 port 1 get link 2>/dev/null | grep -o "link:[^ ]*" | cut -d":" -f2 || echo "down")

	local l1_speed=$(swconfig dev switch1 port 2 get link 2>/dev/null | grep -o "speed:[^ ]*" | cut -d":" -f2 || echo "")
	local l1_link=$(swconfig dev switch1 port 2 get link 2>/dev/null | grep -o "link:[^ ]*" | cut -d":" -f2 || echo "down")

	printf '{"wan":{"speed":"%s","duplex":"%s","carrier":"%s"},"lan1":{"speed":"%s","link":"%s"},"lan2":{"speed":"%s","link":"%s"}}' \
		"$w_speed" "$w_duplex" "$w_carrier" "$l0_speed" "$l0_link" "$l1_speed" "$l1_link"
}

get_stations_json() {
	local first=1
	printf '['
	for dev in ath0 ath1 ath2; do
		local wdev="wifi${dev#ath}"
		local sock="/var/run/hostapd-$wdev/$dev"
		[ -S "$sock" ] || sock="/var/run/hostapd/$dev"
		[ -S "$sock" ] || continue
		local b="2.4 GHz"
		[ "$dev" = "ath1" ] && b="5 GHz"
		[ "$dev" = "ath2" ] && b="6 GHz"
		local s=$(uci -q get wireless.${wdev}_ap.ssid || echo "")
		local cur_mac="" cur_sig="0" cur_time="0" cur_flags=""
		
		while IFS= read -r line; do
			case "$line" in
				Selected*) continue ;;
				[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:*)
					if [ -n "$cur_mac" ]; then
						[ $first -eq 0 ] && printf ','
						first=0
						local hip=$(awk -v m="$cur_mac" 'tolower($2)==tolower(m){print $3,$4}' /tmp/dhcp.leases 2>/dev/null)
						local ip=$(echo "$hip" | awk '{print $1}')
						local h=$(echo "$hip" | awk '{print $2}')
						[ -z "$h" ] && h="?"
						printf '{"mac":"%s","iface":"%s","device":"%s","band":"%s","ssid":"%s","hostname":"%s","ip":"%s","signal":%s,"connected_time":%s,"flags":"%s"}' \
							"$cur_mac" "$dev" "$wdev" "$b" "$s" "$h" "$ip" "$cur_sig" "$cur_time" "$cur_flags"
					fi
					cur_mac="$line"
					cur_sig="0"
					cur_time="0"
					cur_flags=""
					;;
				signal=*) cur_sig="${line#signal=}" ;;
				connected_time=*) cur_time="${line#connected_time=}" ;;
				flags=*) cur_flags="${line#flags=}" ;;
			esac
		done << EOF
$(hostapd_cli -p "${sock%/*}" -i "$dev" all_sta 2>/dev/null)
EOF
		if [ -n "$cur_mac" ]; then
			[ $first -eq 0 ] && printf ','
			first=0
			local hip=$(awk -v m="$cur_mac" 'tolower($2)==tolower(m){print $3,$4}' /tmp/dhcp.leases 2>/dev/null)
			local ip=$(echo "$hip" | awk '{print $1}')
			local h=$(echo "$hip" | awk '{print $2}')
			[ -z "$h" ] && h="?"
			printf '{"mac":"%s","iface":"%s","device":"%s","band":"%s","ssid":"%s","hostname":"%s","ip":"%s","signal":%s,"connected_time":%s,"flags":"%s"}' \
				"$cur_mac" "$dev" "$wdev" "$b" "$s" "$h" "$ip" "$cur_sig" "$cur_time" "$cur_flags"
		fi
	done
	printf ']'
}

do_set_telnet() {
	read input
	local en=$(echo "$input" | jsonfilter -e '@.enabled')
	local telnetd_bin=$(command -v telnetd || echo "/usr/sbin/telnetd")
	if [ "$en" = "1" ] || [ "$en" = "true" ]; then
		uci set system.telnet=telnet 2>/dev/null || true
		uci set system.telnet.enable='1'
		uci commit system
		[ -n "$(pidof telnetd)" ] || $telnetd_bin -l /bin/ash &
		echo '{"success": true, "telnet_enabled": "1", "telnet_running": "1"}'
	else
		uci set system.telnet=telnet 2>/dev/null || true
		uci set system.telnet.enable='0'
		uci commit system
		killall -9 telnetd 2>/dev/null
		echo '{"success": true, "telnet_enabled": "0", "telnet_running": "0"}'
	fi
}

get_apps_json() {
	local wg_mod="0"
	lsmod 2>/dev/null | grep -q "^wireguard" && wg_mod="1"
	local wg_en="0"
	if [ "$(uci -q get network.wg0.proto)" = "wireguard" ] && [ "$(uci -q get network.wg0.disabled)" != "1" ] && [ "$(uci -q get network.wg0.auto)" != "0" ]; then
		wg_en="1"
	fi
	local wg_up="0"
	ip link show wg0 2>/dev/null | grep -q "UP" && wg_up="1"
	local wg_priv=$(uci -q get network.wg0.private_key || echo "")
	local wg_mtu=$(uci -q get network.wg0.mtu || echo "1420")
	local wg_addr=$(uci -q get network.wg0.addresses | awk '{print $1}')
	local wg_pub=$(uci -q get network.wgpeer0.public_key || uci -q get network.@wireguard_wg0[0].public_key || echo "")
	local wg_psk=$(uci -q get network.wgpeer0.preshared_key || uci -q get network.@wireguard_wg0[0].preshared_key || echo "")
	local wg_ep_h=$(uci -q get network.wgpeer0.endpoint_host || uci -q get network.@wireguard_wg0[0].endpoint_host || echo "")
	local wg_ep_p=$(uci -q get network.wgpeer0.endpoint_port || uci -q get network.@wireguard_wg0[0].endpoint_port || echo "51820")
	local wg_allow=$(uci -q get network.wgpeer0.allowed_ips || uci -q get network.@wireguard_wg0[0].allowed_ips || echo "0.0.0.0/0")
	wg_allow=$(echo "$wg_allow" | tr ' ' ',')
	local wg_keep=$(uci -q get network.wgpeer0.persistent_keepalive || uci -q get network.@wireguard_wg0[0].persistent_keepalive || echo "25")
	local wg_ep=""
	[ -n "$wg_ep_h" ] && wg_ep="${wg_ep_h}:${wg_ep_p:-51820}"
	local wg_rx=$(cat /sys/class/net/wg0/statistics/rx_bytes 2>/dev/null || echo "0")
	local wg_tx=$(cat /sys/class/net/wg0/statistics/tx_bytes 2>/dev/null || echo "0")

	local ovpn_inst="0"
	[ -x /usr/sbin/openvpn ] && ovpn_inst="1"
	local ovpn_run="0"
	[ -n "$(pidof openvpn)" ] && ovpn_run="1"
	local ovpn_cnt=$(grep -c "^config openvpn" /etc/config/openvpn 2>/dev/null || echo "0")

	local igmp_en="0"
	if [ -n "$(pidof mcproxy)" ] || [ -n "$(pidof igmpproxy)" ] || [ "$(uci -q get tripleband.tripleband.igmpproxy_enable)" = "1" ] || [ "$(uci -q get mcproxy.mcproxy.disabled)" = "0" ]; then
		igmp_en="1"
	fi

	local doh_en="0"
	[ -n "$(pidof https-dns-proxy)" ] && doh_en="1"
	local quic_en="0"
	if iptables -S FORWARD 2>/dev/null | grep -qiE "udp.*--dport 443.*(DROP|REJECT)|443.*udp.*(DROP|REJECT)"; then
		quic_en="1"
	elif [ "$(uci -q get tripleband.tripleband.quic_block)" = "1" ]; then
		iptables -I FORWARD 1 -p udp --dport 443 -j REJECT 2>/dev/null || true
		quic_en="1"
	fi

	local opkg_ok="0"
	grep -q "archive.openwrt.org/releases/19.07.10" /etc/opkg/distfeeds.conf 2>/dev/null && opkg_ok="1"
	local opkg_held=$(grep -c "Status: install hold installed" /usr/lib/opkg/status 2>/dev/null || echo "0")

	local sch_en=$(uci -q get tripleband.tripleband.sched_enable || uci -q get wifi_schedule.global.enabled || echo "0")
	local sch_off=$(uci -q get tripleband.tripleband.sched_start || uci -q get wifi_schedule.global.off_time || echo "00:00")
	local sch_on=$(uci -q get tripleband.tripleband.sched_stop || uci -q get wifi_schedule.global.on_time || echo "06:00")
	local sch_days=$(uci -q get tripleband.tripleband.sched_days || echo "*")

	local hapd_ver="v2.10-QSDK"
	[ -x /usr/sbin/qca-hapd-supp ] && hapd_ver="v2.11-devel (SPF 12.4)"

	local iperf_run="0"
	[ -n "$(pidof iperf)" ] && iperf_run="1"
	local mtu_fix="1"
	local wan_mtu=$(cat /sys/class/net/eth0/mtu 2>/dev/null | tr -cd '0-9')
	[ -z "$wan_mtu" ] && wan_mtu="1500"

	local wol_json="["
	local wfirst=1
	if [ -f /tmp/dhcp.leases ]; then
		while read -r ts mac ip name id; do
			[ -z "$mac" ] && continue
			local clean_mac=$(echo "$mac" | tr 'a-f' 'A-F')
			local clean_name=$(echo "$name" | tr -cd 'a-zA-Z0-9_.-')
			[ -z "$clean_name" ] || [ "$clean_name" = "*" ] && clean_name="Device"
			local arp_fl=$(awk -v m="$mac" 'tolower($4)==tolower(m){print $3}' /proc/net/arp 2>/dev/null | head -n1)
			local online="0"
			[ "$arp_fl" = "0x2" ] && online="1"
			[ $wfirst -eq 0 ] && wol_json="${wol_json},"
			wfirst=0
			wol_json="${wol_json}{\"mac\":\"${clean_mac}\",\"ip\":\"${ip}\",\"name\":\"${clean_name}\",\"online\":\"${online}\"}"
		done < /tmp/dhcp.leases
	fi
	wol_json="${wol_json}]"

	printf '{"wg_loaded":"%s","wg_enabled":"%s","wg_up":"%s","wg_endpoint":"%s","wg_endpoint_host":"%s","wg_endpoint_port":"%s","wg_address":"%s","wg_priv":"%s","wg_pub":"%s","wg_psk":"%s","wg_allowed_ips":"%s","wg_keepalive":"%s","wg_mtu":"%s","wg_rx":"%s","wg_tx":"%s","openvpn_installed":"%s","openvpn_running":"%s","openvpn_profiles":"%s","igmp_enabled":"%s","doh_enabled":"%s","quic_blocked":"%s","opkg_feeds_ok":"%s","opkg_held_count":"%s","sched_enabled":"%s","sched_off":"%s","sched_on":"%s","sched_days":"%s","hapd_ver":"%s","iperf_running":"%s","mtu_fix":"%s","wan_mtu":"%s","wol_hosts":%s}' \
		"$wg_mod" "$wg_en" "$wg_up" "$wg_ep" "$wg_ep_h" "$wg_ep_p" "$wg_addr" "$wg_priv" "$wg_pub" "$wg_psk" "$wg_allow" "$wg_keep" "$wg_mtu" "${wg_rx:-0}" "${wg_tx:-0}" "$ovpn_inst" "$ovpn_run" "$ovpn_cnt" "$igmp_en" "$doh_en" "$quic_en" "$opkg_ok" "$opkg_held" "$sch_en" "$sch_off" "$sch_on" "$sch_days" "$hapd_ver" "$iperf_run" "$mtu_fix" "$wan_mtu" "$wol_json"
}

