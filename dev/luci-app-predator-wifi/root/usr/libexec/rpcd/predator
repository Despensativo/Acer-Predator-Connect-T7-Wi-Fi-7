	printf '{"mode":"%s","mlo_enabled":"%s","telnet_enabled":"%s","telnet_running":"%s","features":{"gaming_mode":"%s","mscs_scs":"%s","twt":"%s","cca_mitigation":"%s","compat_iot":"%s","sqm_cake":"%s","ani":"%s","qam4096":"%s","rnr_6g":"%s","rps":"%s","puncturing":"%s","beamforming":"%s"},"silicon":{"sfe_ipv4":"%s","sfe_ipv6":"%s","sfe_stopped":"%s","sqm_enabled":"%s","mscs":"%s","scs":"%s","cake_offload":"%s","rtwt":"%s","t2lm":"%s","cca_mitigation":"%s","compat_iot":"%s","wisp_en":"%s","wisp_ssid":"%s","wisp_dev":"%s"},"apps":' \
		"$mode" "$mlo_en" "$tel_en" "$tel_run" "$gaming" "$mscs_scs" "$twt" "$cca" "$compat_iot" "$sqm_en" "$ani" "$qam" "$rnr" "$rps" "$punct" "$bf" "${sfe4:-0}" "${sfe6:-0}" "${sfe_stop:-0}" "$sqm_en" "${mscs_en:-$mscs_scs}" "${scs_en:-$mscs_scs}" "${cake_en:-1}" "$rtwt_en" "$t2lm_en" "$cca" "$compat_iot" "$wisp_en" "$wisp_ssid" "$wisp_dev"
	get_apps_json
	printf ',"ports":'
	get_ports_json
	printf ',"radios":'
	get_radios_json
	printf ',"interfaces":'
	get_ifaces_json
	printf ',"stations":'
