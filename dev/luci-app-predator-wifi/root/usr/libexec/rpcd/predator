	local sfe4=$(cat /sys/kernel/debug/ecm/ecm_sfe_ipv4/accelerated_count 2>/dev/null | tr -cd '0-9')
	local sfe6=$(cat /sys/kernel/debug/ecm/ecm_sfe_ipv6/accelerated_count 2>/dev/null | tr -cd '0-9')
