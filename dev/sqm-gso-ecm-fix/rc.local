# /etc/rc.local - Inicializacao Automatica (Debloat Stock Max + Qualcomm High Performance)
ubus call system watchdog '{"stop": false, "frequency": 5}' 2>/dev/null; sysctl -w kernel.panic=0 2>/dev/null; echo 0 > /proc/sys/kernel/panic 2>/dev/null
chmod -R 755 /www /usr/share/luci /usr/share/rpcd 2>/dev/null || true

# Trava do firmware QCN9224 MLO IPC (Zero Crash) e sincronizacao de INIs Qualcomm (/ini <-> /cfg/default/ini)
[ -f /ini/internal/QCN9224_i.ini ] && sed -i 's/dp_mlo_reo_rings_map=.*/dp_mlo_reo_rings_map=0/' /ini/internal/QCN9224_i.ini 2>/dev/null || true
if [ -d /cfg/default/ini ]; then
    cp -f /ini/global.ini /cfg/default/ini/global.ini 2>/dev/null || true
    cp -f /ini/internal/QCN9224_i.ini /cfg/default/ini/internal/QCN9224_i.ini 2>/dev/null || true
    cp -f /ini/internal/QCA5332_i.ini /cfg/default/ini/internal/QCA5332_i.ini 2>/dev/null || true
fi

# 1. Manter uhttpd (LuCI) e DoH (https-dns-proxy) sempre ativos
/etc/init.d/uhttpd start 2>/dev/null
/etc/init.d/https-dns-proxy start 2>/dev/null

# 2. Desativar lighttpd e processos de telemetria da Acer se algo tentar subir
killall -9 lighttpd mqttClient breakpad monitord 2>/dev/null

# 3. Garantir Dropbear (SSH) e Telnet sempre ativos e monitorados
uci -q set dropbear.@dropbear[0].enable='1' && uci -q commit dropbear 2>/dev/null || true
/etc/init.d/dropbear enable 2>/dev/null
/etc/init.d/dropbear restart 2>/dev/null

/etc/init.d/telnet enable 2>/dev/null
/etc/init.d/telnet start 2>/dev/null
TELNETD=$(command -v telnetd || echo "/usr/sbin/telnetd")
if [ -x "$TELNETD" ]; then
    pgrep -x telnetd >/dev/null 2>&1 || $TELNETD -l /bin/ash &
fi

# 3.1 Garantir KSMBD (compartilhamento de arquivos) e ferramentas ativas
chmod +x /usr/sbin/ksmbd-disk-tool /etc/init.d/ksmbd 2>/dev/null || true
/etc/init.d/ksmbd enable 2>/dev/null
/etc/init.d/ksmbd start 2>/dev/null

# 4. CPU Turbo Lock: Todos os 4 núcleos do Qualcomm IPQ5332 em 1.5 GHz Turbo (performance)
for c in /sys/devices/system/cpu/cpu[0-3]; do
    [ -d "$c/cpufreq" ] && echo "performance" > "$c/cpufreq/scaling_governor" 2>/dev/null || true
done

# 5. Otimizacoes de Rede, Acelerador PPE e Buffers do Kernel Qualcomm
echo "16384" > /proc/net/skb_recycler/max_skbs 2>/dev/null || true
echo 1 > /sys/sfe/ppe_rfs_feature 2>/dev/null || true
echo 4 > /proc/sys/net/edma/rps_num_cores 2>/dev/null || true
sysctl -w net.bridge.bridge-nf-call-iptables=0 2>/dev/null || true
sysctl -w net.bridge.bridge-nf-call-ip6tables=0 2>/dev/null || true

# 6. Receive Packet Steering (RPS) quad-core em todas as interfaces de rede e Wi-Fi
for q in /sys/class/net/*/queues/rx-*; do
    [ -f "$q/rps_cpus" ] && echo "f" > "$q/rps_cpus" 2>/dev/null || true
done

# 7. Modulos de mesh/plc (repacd, wsplcd) mantidos desligados por padrao (sem consumo de CPU)
uci -q set repacd.repacd.Enable='0' && uci -q commit repacd 2>/dev/null || true
uci -q set wsplcd.config.HyFiSecurity='0' && uci -q commit wsplcd 2>/dev/null || true

# 8. Eliminar 464xlat residual (evita loop de reinicializacao de wan_6_4)
rm -f /lib/netifd/proto/464xlat.sh 2>/dev/null

# 9. Garantir DHCP Leases persistentes entre reboots (ex: Impressoras 3D / IoT) e symlink compativel
[ -f /etc/dhcp.leases ] || touch /etc/dhcp.leases
if [ ! -L /tmp/dhcp.leases ]; then
    [ -s /tmp/dhcp.leases ] && [ ! -s /etc/dhcp.leases ] && cp -f /tmp/dhcp.leases /etc/dhcp.leases 2>/dev/null
    rm -f /tmp/dhcp.leases 2>/dev/null
    ln -sf /etc/dhcp.leases /tmp/dhcp.leases 2>/dev/null
fi
chown dnsmasq:dnsmasq /etc/dhcp.leases 2>/dev/null || true
chmod 666 /etc/dhcp.leases 2>/dev/null || true

# 10. Sincronizacao Inteligente de Horario (Anycast Global) e Auto-Fuso por Geo-IP
chmod +x /etc/hotplug.d/iface/25-ntp-smart 2>/dev/null || true
[ -x /etc/hotplug.d/iface/25-ntp-smart ] && ACTION=boot INTERFACE=boot /etc/hotplug.d/iface/25-ntp-smart

# 11. Reconexao automatica pos-boot do modo WISP (Wi-Fi como WAN) se configurado
if [ -n "$(uci -q get wireless.wwan_sta.device)" ] && [ "$(uci -q get wireless.wwan_sta.disabled)" != "1" ]; then
    ( sleep 15 && /sbin/ifup wwan 2>/dev/null ) &
fi

# 12. Garantir patch de WPA2/WPA3 Misto (sae-mixed) no hostapd.sh da Qualcomm
if [ -f /lib/wifi/hostapd.sh ] && ! grep -q "sae-mixed" /lib/wifi/hostapd.sh; then
    sed -i "s/\*psk\*)/\*psk\*|\*sae-mixed\*)/g" /lib/wifi/hostapd.sh 2>/dev/null || true
    sed -i "s/\*psk\*);;/\*psk\*|\*sae-mixed\*);;/g" /lib/wifi/hostapd.sh 2>/dev/null || true
fi

# 13. Predator T7 SQM CAKE + Wi-Fi 7 6GHz Fix (GSO na eth0 + pausa SFE apenas se SQM ativo)
ethtool -K eth0 gso on 2>/dev/null || true
if [ "$(uci -q get sqm.wan.enabled)" = "1" ]; then
    echo 1 > /sys/kernel/debug/ecm/front_end_ipv4_stop 2>/dev/null || true
    echo 1 > /sys/kernel/debug/ecm/front_end_ipv6_stop 2>/dev/null || true
    echo 1 > /sys/kernel/debug/ecm/ecm_db/defunct_all 2>/dev/null || true
fi

# 14. Garantir servico Predator RF & Silicon QoS ativo (Gaming/MSCS/SCS/TxBF/RNR)
chmod +x /etc/init.d/predator_rf 2>/dev/null || true
/etc/init.d/predator_rf enable 2>/dev/null || true
/etc/init.d/predator_rf start 2>/dev/null || true

exit 0

